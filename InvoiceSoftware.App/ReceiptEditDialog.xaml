<Window x:Class="InvoiceSoftware.App.ReceiptEditDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Modify Receipt"
        Width="500" Height="600" MinHeight="560"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize"
        Background="#F4F7FB">
    <Border Margin="14" Padding="18" Background="White" BorderBrush="#DFE7F3" BorderThickness="1" CornerRadius="8">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Margin="0,0,0,14">
                <TextBlock Text="Modify receipt" FontSize="20" FontWeight="SemiBold" Foreground="#0D2B68" />
                <TextBlock Text="{Binding ReceiptSummary}" Foreground="#42526B" Margin="0,4,0,0" />
                <TextBlock Text="{Binding InvoiceSummary}" Foreground="#42526B" TextWrapping="Wrap" />
            </StackPanel>

            <StackPanel Grid.Row="1" Margin="0,0,0,10">
                <TextBlock Text="Receipt date" FontWeight="SemiBold" />
                <DatePicker SelectedDate="{Binding ReceiptDate}" />
            </StackPanel>

            <StackPanel Grid.Row="2" Margin="0,0,0,10">
                <TextBlock Text="Payment amount" FontWeight="SemiBold" />
                <TextBox Text="{Binding PaymentAmountDisplay, Mode=OneWay}" IsReadOnly="True" Background="#F3F7FC" />
                <TextBlock Text="The amount is locked to protect the invoice balance. Delete and recreate the receipt if the amount is wrong."
                           Foreground="#64748B" FontSize="11" TextWrapping="Wrap" Margin="0,3,0,0" />
            </StackPanel>

            <StackPanel Grid.Row="3" Margin="0,0,0,10">
                <TextBlock Text="Payment method" FontWeight="SemiBold" />
                <ComboBox ItemsSource="{Binding PaymentMethods}" SelectedItem="{Binding PaymentMethod}" />
            </StackPanel>

            <StackPanel Grid.Row="4" Margin="0,0,0,10">
                <TextBlock Text="Transaction reference / check number" FontWeight="SemiBold" />
                <TextBox Text="{Binding TransactionReference, UpdateSourceTrigger=PropertyChanged}" />
            </StackPanel>

            <StackPanel Grid.Row="5" Margin="0,0,0,10">
                <TextBlock Text="Received by" FontWeight="SemiBold" />
                <TextBox Text="{Binding ReceivedBy, UpdateSourceTrigger=PropertyChanged}" />
            </StackPanel>

            <StackPanel Grid.Row="6" Margin="0,0,0,12">
                <TextBlock Text="Receipt notes" FontWeight="SemiBold" />
                <TextBox Text="{Binding Notes, UpdateSourceTrigger=PropertyChanged}" Height="76" TextWrapping="Wrap" AcceptsReturn="True" />
            </StackPanel>

            <StackPanel Grid.Row="7" Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Cancel" Width="86" Click="Cancel_Click" Background="#64748B" IsCancel="True" />
                <Button Content="Save Changes" Width="120" Click="Save_Click" IsDefault="True" />
            </StackPanel>
        </Grid>
    </Border>
</Window>
