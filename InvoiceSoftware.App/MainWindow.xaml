                                <TextBlock Text="{Binding StockWarning}" Foreground="#B45309" FontWeight="SemiBold" Margin="0,6,0,0" />
                            </StackPanel>
                        </Border>

                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="2*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <TextBlock Text="Commercial terms and notes" FontSize="17" FontWeight="SemiBold" />
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                                        <StackPanel Margin="0,0,8,0">
                                            <TextBlock Text="Payment terms"/><TextBox Text="{Binding CurrentQuotation.PaymentTerms, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" Height="48" TextWrapping="Wrap"/>
                                            <TextBlock Text="Delivery terms"/><TextBox Text="{Binding CurrentQuotation.DeliveryTerms, UpdateSourceTrigger=PropertyChanged}"/>
                                            <TextBlock Text="Delivery period"/><TextBox Text="{Binding CurrentQuotation.DeliveryPeriod, UpdateSourceTrigger=PropertyChanged}"/>
                                            <TextBlock Text="Warranty"/><TextBox Text="{Binding CurrentQuotation.Warranty, UpdateSourceTrigger=PropertyChanged}"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="Public notes (printed)"/><TextBox Text="{Binding CurrentQuotation.PublicNotes, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" Height="58" TextWrapping="Wrap"/>
                                            <TextBlock Text="Internal notes (not printed)"/><TextBox Text="{Binding CurrentQuotation.InternalNotes, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" Height="58" TextWrapping="Wrap"/>
                                            <TextBlock Text="Terms and conditions"/><TextBox Text="{Binding CurrentQuotation.TermsAndConditions, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" Height="70" TextWrapping="Wrap"/>
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="1" Style="{StaticResource Card}">
                                <StackPanel>
                                    <TextBlock Text="Totals" FontSize="17" FontWeight="SemiBold" />
                                    <TextBlock Text="Overall discount type"/><ComboBox ItemsSource="{Binding DiscountTypes}" SelectedItem="{Binding CurrentQuotation.OverallDiscountType}"/>
                                    <TextBlock Text="Overall discount value"/><TextBox Text="{Binding CurrentQuotation.OverallDiscountValue, UpdateSourceTrigger=PropertyChanged}"/>
                                    <TextBlock Text="Shipping / delivery"/><TextBox Text="{Binding CurrentQuotation.ShippingCharge, UpdateSourceTrigger=PropertyChanged}"/>
                                    <TextBlock Text="Additional charges"/><TextBox Text="{Binding CurrentQuotation.AdditionalCharges, UpdateSourceTrigger=PropertyChanged}"/>
                                    <TextBlock Text="Rounding adjustment"/><TextBox Text="{Binding CurrentQuotation.RoundingAdjustment, UpdateSourceTrigger=PropertyChanged}"/>
                                    <Separator Margin="0,7"/>
                                    <TextBlock Text="{Binding CurrentQuotation.Subtotal, StringFormat=Subtotal: {0:N2}}"/>
                                    <TextBlock Text="{Binding CurrentQuotation.DiscountTotal, StringFormat=Discount: {0:N2}}"/>
                                    <TextBlock Text="{Binding CurrentQuotation.NetAmount, StringFormat=Net: {0:N2}}"/>
                                    <TextBlock Text="{Binding CurrentQuotation.TaxTotal, StringFormat=Tax: {0:N2}}"/>
                                    <TextBlock Text="{Binding CurrentQuotation.GrandTotal, StringFormat=Grand Total: {0:N2}}" FontSize="18" FontWeight="Bold" Foreground="#17365D" Margin="0,6,0,0"/>
                                </StackPanel>
                            </Border>
                        </Grid>

                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="Revision and status history" FontSize="17" FontWeight="SemiBold" />
                                <DataGrid ItemsSource="{Binding CurrentQuotation.StatusHistory}" IsReadOnly="True" AutoGenerateColumns="False" Height="120">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Changed" Binding="{Binding ChangedAt, StringFormat=g}" Width="135"/>
                                        <DataGridTextColumn Header="From" Binding="{Binding PreviousStatus}" Width="100"/>
                                        <DataGridTextColumn Header="To" Binding="{Binding NewStatus}" Width="130"/>
                                        <DataGridTextColumn Header="Changed By" Binding="{Binding ChangedBy}" Width="110"/>
                                        <DataGridTextColumn Header="Notes" Binding="{Binding Notes}" Width="*"/>
                                    </DataGrid.Columns>
                                </DataGrid>
                                <TextBlock Text="{Binding StatusMessage}" Foreground="#17365D" Margin="0,6,0,0" />
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <StackPanel DataContext="{Binding Quotations}"
                                Visibility="{Binding DataContext.SelectedSection, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource SectionVisibility}, ConverterParameter=Quotations}">
                        <WrapPanel>
                            <Border Style="{StaticResource Card}" Width="155"><StackPanel><TextBlock Text="Total quotations"/><TextBlock Text="{Binding Statistics.Total}" FontSize="22" FontWeight="Bold"/></StackPanel></Border>
                            <Border Style="{StaticResource Card}" Width="130"><StackPanel><TextBlock Text="Draft"/><TextBlock Text="{Binding Statistics.Draft}" FontSize="22" FontWeight="Bold"/></StackPanel></Border>
                            <Border Style="{StaticResource Card}" Width="130"><StackPanel><TextBlock Text="Sent"/><TextBlock Text="{Binding Statistics.Sent}" FontSize="22" FontWeight="Bold"/></StackPanel></Border>
                            <Border Style="{StaticResource Card}" Width="130"><StackPanel><TextBlock Text="Accepted"/><TextBlock Text="{Binding Statistics.Accepted}" FontSize="22" FontWeight="Bold"/></StackPanel></Border>
                            <Border Style="{StaticResource Card}" Width="130"><StackPanel><TextBlock Text="Converted"/><TextBlock Text="{Binding Statistics.Converted}" FontSize="22" FontWeight="Bold"/></StackPanel></Border>
                            <Border Style="{StaticResource Card}" Width="160"><StackPanel><TextBlock Text="Quoted value"/><TextBlock Text="{Binding Statistics.TotalQuotedValue, StringFormat=N2}" FontSize="22" FontWeight="Bold"/></StackPanel></Border>
                            <Border Style="{StaticResource Card}" Width="145"><StackPanel><TextBlock Text="Acceptance rate"/><TextBlock Text="{Binding Statistics.AcceptanceRate, StringFormat={}{0:N2}%}" FontSize="22" FontWeight="Bold"/></StackPanel></Border>
                            <Border Style="{StaticResource Card}" Width="145"><StackPanel><TextBlock Text="Conversion rate"/><TextBlock Text="{Binding Statistics.ConversionRate, StringFormat={}{0:N2}%}" FontSize="22" FontWeight="Bold"/></StackPanel></Border>
                        </WrapPanel>
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="Search and filter quotations" FontSize="17" FontWeight="SemiBold" />
                                <WrapPanel>
                                    <TextBox Width="220" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" ToolTip="Quotation number, customer, project, subject, or customer reference" />
                                    <ComboBox Width="180" ItemsSource="{Binding Customers}" SelectedItem="{Binding FilterCustomer}" DisplayMemberPath="Name" ToolTip="Customer" />
                                    <DatePicker Width="125" SelectedDate="{Binding FilterFrom}" ToolTip="From date" />
                                    <DatePicker Width="125" SelectedDate="{Binding FilterTo}" ToolTip="To date" />
                                    <ComboBox Width="145" ItemsSource="{Binding StatusFilters}" SelectedItem="{Binding FilterStatus}" ToolTip="Status" />
                                    <ComboBox Width="120" ItemsSource="{Binding ValidityFilters}" SelectedItem="{Binding FilterValidity}" ToolTip="Validity" />
                                    <CheckBox Content="Include archived" IsChecked="{Binding IncludeArchived}" VerticalAlignment="Center" Margin="6,0,10,0" />
                                    <Button Content="Search" Command="{Binding SearchCommand}" />
                                    <Button Content="New Quotation" Command="{Binding NewCommand}" />
                                    <Button Content="Export CSV" Command="{Binding ExportCsvCommand}" />
                                </WrapPanel>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <DataGrid ItemsSource="{Binding Quotations}" SelectedItem="{Binding SelectedQuotation}" AutoGenerateColumns="False" IsReadOnly="True" Height="420" HorizontalScrollBarVisibility="Auto">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Quotation Number" Binding="{Binding QuotationNumber}" Width="145"/>
                                        <DataGridTextColumn Header="Rev." Binding="{Binding RevisionNumber}" Width="48"/>
                                        <DataGridTextColumn Header="Date" Binding="{Binding QuotationDate, StringFormat=d}" Width="90"/>
                                        <DataGridTextColumn Header="Customer" Binding="{Binding CustomerNameSnapshot}" Width="185"/>
                                        <DataGridTextColumn Header="Project / Subject" Binding="{Binding ProjectName}" Width="160"/>
                                        <DataGridTextColumn Header="Subtotal" Binding="{Binding Subtotal, StringFormat=N2}" Width="85"/>
                                        <DataGridTextColumn Header="Discount" Binding="{Binding DiscountTotal, StringFormat=N2}" Width="85"/>
                                        <DataGridTextColumn Header="Tax" Binding="{Binding TaxTotal, StringFormat=N2}" Width="75"/>
                                        <DataGridTextColumn Header="Total" Binding="{Binding GrandTotal, StringFormat=N2}" Width="90"/>
                                        <DataGridTextColumn Header="Currency" Binding="{Binding CurrencyCode}" Width="65"/>
                                        <DataGridTextColumn Header="Valid Until" Binding="{Binding ValidUntil, StringFormat=d}" Width="90"/>
                                        <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="130"/>
                                        <DataGridCheckBoxColumn Header="Archived" Binding="{Binding IsArchived}" Width="75"/>
                                        <DataGridTextColumn Header="Created By" Binding="{Binding CreatedBy}" Width="95"/>
                                        <DataGridTextColumn Header="Last Modified" Binding="{Binding ModifiedAt, StringFormat=g}" Width="130"/>
                                    </DataGrid.Columns>
                                </DataGrid>
                                <WrapPanel Margin="0,8,0,0">
                                    <Button Content="Open / Modify" Command="{Binding EditCommand}" CommandParameter="{Binding SelectedQuotation}" />
                                    <Button Content="Duplicate" Command="{Binding DuplicateCommand}" CommandParameter="{Binding SelectedQuotation}" />
                                    <Button Content="Create Revision" Command="{Binding CreateRevisionCommand}" CommandParameter="{Binding SelectedQuotation}" />
                                    <Button Content="Convert to Invoice" Command="{Binding ConvertToInvoiceCommand}" CommandParameter="{Binding SelectedQuotation}" Background="#1E7480" />
                                    <Button Content="Archive" Command="{Binding ArchiveCommand}" CommandParameter="{Binding SelectedQuotation}" Background="#B91C1C" />
                                    <Button Content="Delete Permanently" Command="{Binding DeleteCommand}" CommandParameter="{Binding SelectedQuotation}" Background="#8B1A1A" />
                                </WrapPanel>
                                <TextBlock Text="{Binding StatusMessage}" Foreground="#17365D" Margin="0,6,0,0" />
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <StackPanel Visibility="{Binding SelectedSection, Converter={StaticResource SectionVisibility}, ConverterParameter=Customers}">
                        <StackPanel Orientation="Horizontal">
                            <Button Content="Add Customer" Command="{Binding AddCustomerCommand}" />
                            <Button Content="Save Customer" Command="{Binding SaveCustomerCommand}" />
                            <Button Content="Delete Customer" Command="{Binding DeleteCustomerCommand}" Background="#B91C1C" />
                        </StackPanel>
                        <Border Style="{StaticResource Card}">
                            <DataGrid ItemsSource="{Binding Customers}" SelectedItem="{Binding SelectedCustomer}" AutoGenerateColumns="True" />
                        </Border>
                    </StackPanel>

                    <StackPanel Visibility="{Binding SelectedSection, Converter={StaticResource SectionVisibility}, ConverterParameter=Products and Services}">
                        <Button Content="Add Product / Service" Command="{Binding AddProductCommand}" HorizontalAlignment="Left" />
                        <Border Style="{StaticResource Card}">
                            <DataGrid ItemsSource="{Binding Products}" SelectedItem="{Binding SelectedProduct}" AutoGenerateColumns="True" />
                        </Border>
                    </StackPanel>

                    <StackPanel Visibility="{Binding SelectedSection, Converter={StaticResource SectionVisibility}, ConverterParameter=Store / Inventory}">
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <WrapPanel>
                                    <Button Content="Product  ▾" MinWidth="118" Tag="{Binding}" Click="InvoiceActionsButton_Click" ToolTip="Create, save, duplicate, clear, or delete a product">
                                        <Button.ContextMenu>
                                            <ContextMenu Style="{StaticResource InvoiceActionsMenu}" Opened="InvoiceActionsMenu_Opened" Closed="InvoiceActionsMenu_Closed">
                                                <MenuItem Header="New Product" Style="{StaticResource InvoiceActionMenuItem}" Command="{Binding PlacementTarget.Tag.NewInventoryProductCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                                <MenuItem Header="Save Product" Style="{StaticResource InvoiceActionMenuItem}" Command="{Binding PlacementTarget.Tag.SaveInventoryProductCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                                <MenuItem Header="Duplicate Product" Style="{StaticResource InvoiceActionMenuItem}" Command="{Binding PlacementTarget.Tag.DuplicateInventoryProductCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                                <MenuItem Header="Clear Form" Style="{StaticResource InvoiceActionMenuItem}" Command="{Binding PlacementTarget.Tag.ClearInventoryProductCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                                <Separator Margin="5,4" />
                                                <MenuItem Header="Delete Product" Style="{StaticResource InvoiceDeleteMenuItem}" Command="{Binding PlacementTarget.Tag.DeleteInventoryProductCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                            </ContextMenu>
                                        </Button.ContextMenu>
                                    </Button>
                                    <Button Content="Data  ▾" MinWidth="102" Tag="{Binding}" Click="InvoiceActionsButton_Click" ToolTip="Refresh, import, or export inventory data">
                                        <Button.ContextMenu>
                                            <ContextMenu Style="{StaticResource InvoiceActionsMenu}" Opened="InvoiceActionsMenu_Opened" Closed="InvoiceActionsMenu_Closed">
                                                <MenuItem Header="Refresh Product List" Style="{StaticResource InvoiceActionMenuItem}" Command="{Binding PlacementTarget.Tag.SearchInventoryCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                                <Separator Margin="5,4" />
                                                <MenuItem Header="Import Products from CSV" Style="{StaticResource InvoiceActionMenuItem}" Command="{Binding PlacementTarget.Tag.ImportProductsCsvCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                                <MenuItem Header="Export Products to CSV" Style="{StaticResource InvoiceActionMenuItem}" Command="{Binding PlacementTarget.Tag.ExportProductsCsvCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                            </ContextMenu>
                                        </Button.ContextMenu>
                                    </Button>
                                    <Button Content="Inventory  ▾" MinWidth="118" Tag="{Binding}" Click="InvoiceActionsButton_Click" ToolTip="Print the product list or view stock movement history">
                                        <Button.ContextMenu>
                                            <ContextMenu Style="{StaticResource InvoiceActionsMenu}" Opened="InvoiceActionsMenu_Opened" Closed="InvoiceActionsMenu_Closed">
                                                <MenuItem Header="Print Product List" Style="{StaticResource InvoiceActionMenuItem}" Command="{Binding PlacementTarget.Tag.PrintProductsCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                                <MenuItem Header="Movement History" Style="{StaticResource InvoiceActionMenuItem}" Command="{Binding PlacementTarget.Tag.ViewStockHistoryCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                            </ContextMenu>
                                        </Button.ContextMenu>
                                    </Button>
                                </WrapPanel>
                                <WrapPanel Margin="0,10,0,0">
                                    <TextBox Width="260" Text="{Binding InventorySearchText, UpdateSourceTrigger=PropertyChanged}" ToolTip="Reference, part number, barcode, product, description, category, brand, supplier, or location">
                                        <TextBox.InputBindings>
                                            <KeyBinding Key="Enter" Command="{Binding SearchInventoryCommand}" />
                                        </TextBox.InputBindings>
                                    </TextBox>
                                    <ComboBox Width="150" ItemsSource="{Binding Categories}" SelectedItem="{Binding SelectedCategoryFilter}" DisplayMemberPath="Name" ToolTip="Category filter" />
                                    <ComboBox Width="160" ItemsSource="{Binding Suppliers}" SelectedItem="{Binding SelectedSupplierFilter}" DisplayMemberPath="CompanyName" ToolTip="Supplier filter" />
                                    <ComboBox Width="110" ItemsSource="{Binding ActiveFilters}" SelectedItem="{Binding InventoryActiveFilter}" />
                                    <CheckBox Content="Low stock only" IsChecked="{Binding LowStockOnly}" VerticalAlignment="Center" Margin="10,0" />
                                    <Button Content="Search" Command="{Binding SearchInventoryCommand}" />
                                </WrapPanel>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource Card}">
                            <DataGrid ItemsSource="{Binding InventoryProducts}" SelectedItem="{Binding InventoryProduct}" IsReadOnly="True" AutoGenerateColumns="False" AlternatingRowBackground="#F7FAFE" CanUserSortColumns="True" MinHeight="230">
                                <DataGrid.RowStyle>
                                    <Style TargetType="DataGridRow">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding StockStatus}" Value="Low Stock"><Setter Property="Background" Value="#FEF3C7"/><Setter Property="Foreground" Value="#92400E"/></DataTrigger>
                                            <DataTrigger Binding="{Binding StockStatus}" Value="Out of Stock"><Setter Property="Background" Value="#FEE2E2"/><Setter Property="Foreground" Value="#991B1B"/></DataTrigger>
                                            <DataTrigger Binding="{Binding StockStatus}" Value="Inactive"><Setter Property="Background" Value="#E5E7EB"/><Setter Property="Foreground" Value="#6B7280"/></DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </DataGrid.RowStyle>
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Reference" Binding="{Binding Code}" Width="105" />
                                    <DataGridTextColumn Header="Product" Binding="{Binding Name}" Width="150" />
                                    <DataGridTextColumn Header="Description" Binding="{Binding Description}" Width="*" />
                                    <DataGridTextColumn Header="Category" Binding="{Binding CategoryRecord.Name}" Width="110" />
                                    <DataGridTextColumn Header="Brand" Binding="{Binding Brand}" Width="100" />
                                    <DataGridTextColumn Header="Cost" Binding="{Binding CostPrice, StringFormat=N2}" Width="75" />
                                    <DataGridTextColumn Header="Selling" Binding="{Binding SellingPrice, StringFormat=N2}" Width="75" />
                                    <DataGridTextColumn Header="Quantity" Binding="{Binding CurrentQuantity, StringFormat={}{0:0.####}}" Width="85" />
                                    <DataGridTextColumn Header="Minimum" Binding="{Binding MinimumQuantity, StringFormat={}{0:0.####}}" Width="80" />
                                    <DataGridTextColumn Header="Location" Binding="{Binding StorageLocation}" Width="95" />
                                    <DataGridTextColumn Header="Status" Binding="{Binding StockStatus}" Width="95" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </Border>
                        <Border Style="{StaticResource Card}" DataContext="{Binding}">
                            <StackPanel>
                                <TextBlock Text="Product details" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,8"/>
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                                    <StackPanel Margin="0,0,10,0">
                                        <TextBlock Text="Reference / Part Number *"/><TextBox Text="{Binding InventoryProduct.Code}"/>
                                        <TextBlock Text="Barcode"/><TextBox Text="{Binding InventoryProduct.Barcode}"/>
                                        <TextBlock Text="Product Name *"/><TextBox Text="{Binding InventoryProduct.Name}"/>
                                        <TextBlock Text="Full Description *"/><TextBox Text="{Binding InventoryProduct.Description}" Height="60" AcceptsReturn="True" TextWrapping="Wrap"/>
                                        <TextBlock Text="Brand / Manufacturer"/><TextBox Text="{Binding InventoryProduct.Brand}"/>
                                        <TextBlock Text="Category"/><ComboBox ItemsSource="{Binding Categories}" DisplayMemberPath="Name" SelectedValuePath="Id" SelectedValue="{Binding InventoryProduct.CategoryId}"/>
                                        <TextBlock Text="Supplier"/><ComboBox ItemsSource="{Binding Suppliers}" DisplayMemberPath="CompanyName" SelectedValuePath="Id" SelectedValue="{Binding InventoryProduct.SupplierId}"/>
                                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                            <Button Content="New Product" Command="{Binding NewInventoryProductCommand}"/>
                                            <Button Content="Save Product" Command="{Binding SaveInventoryProductCommand}"/>
                                        </StackPanel>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Margin="10,0">
                                        <TextBlock Text="Unit of Measurement"/><TextBox Text="{Binding InventoryProduct.Unit, UpdateSourceTrigger=PropertyChanged}"/>
                                        <TextBlock Text="Cost Price"/><TextBox Text="{Binding InventoryCostPrice}"/>
                                        <TextBlock Text="Selling Percentage %"/><TextBox Text="{Binding InventorySellingPercentage, UpdateSourceTrigger=PropertyChanged}" ToolTip="Selling Price = Cost Price + this percentage"/>
                                        <TextBlock Text="Selling Price"/><TextBox Text="{Binding InventorySellingPrice}"/>
                                        <TextBlock Text="Tax Rate %"/><TextBox Text="{Binding InventoryProduct.TaxPercentage}"/>
                                        <TextBlock Text="Current Quantity"/><TextBox Text="{Binding InventoryQuantityInput}" ToolTip="Changes create an auditable stock movement"/>
                                        <TextBlock Text="Stock Adjustment Reason"/><TextBox Text="{Binding StockAdjustmentNotes}"/>
                                        <TextBlock Text="Minimum Stock"/><TextBox Text="{Binding InventoryProduct.MinimumQuantity}"/>
                                        <TextBlock Text="Reorder Quantity"/><TextBox Text="{Binding InventoryProduct.ReorderQuantity}"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" Margin="10,0,0,0">
                                        <TextBlock Text="Storage Location"/><TextBox Text="{Binding InventoryProduct.StorageLocation}"/>
                                        <TextBlock Text="Shelf / Bin"/><TextBox Text="{Binding InventoryProduct.ShelfBinNumber}"/>
                                        <TextBlock Text="Product Type"/><ComboBox SelectedValue="{Binding InventoryProduct.Type}" SelectedValuePath="Tag"><ComboBoxItem Content="Product" Tag="Product"/><ComboBoxItem Content="Service" Tag="Service"/></ComboBox>
                                        <CheckBox Content="Track stock" IsChecked="{Binding InventoryProduct.TrackStock}" Margin="4"/>
                                        <CheckBox Content="Active" IsChecked="{Binding InventoryProduct.IsActive}" Margin="4"/>
                                        <TextBlock Text="Notes"/><TextBox Text="{Binding InventoryProduct.Notes}" Height="90" AcceptsReturn="True" TextWrapping="Wrap"/>
                                        <TextBlock Text="Created / Last Modified" FontWeight="SemiBold" Margin="4"/>
                                        <TextBlock><Run Text="{Binding InventoryProduct.CreatedAt, StringFormat=g, Mode=OneWay}"/><Run Text="  /  "/><Run Text="{Binding InventoryProduct.ModifiedAt, StringFormat=g, Mode=OneWay}"/></TextBlock>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                            <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="Categories" FontSize="18" FontWeight="SemiBold"/><DataGrid ItemsSource="{Binding Categories}" SelectedItem="{Binding SelectedCategory}" AutoGenerateColumns="False" Height="130"><DataGrid.Columns><DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="140"/><DataGridTextColumn Header="Description" Binding="{Binding Description}" Width="*"/><DataGridCheckBoxColumn Header="Active" Binding="{Binding IsActive}" Width="60"/></DataGrid.Columns></DataGrid><StackPanel Orientation="Horizontal"><Button Content="New Category" Command="{Binding NewCategoryCommand}"/><Button Content="Save Category" Command="{Binding SaveCategoryCommand}"/></StackPanel></StackPanel></Border>
                            <Border Grid.Column="1" Style="{StaticResource Card}"><StackPanel><TextBlock Text="Suppliers" FontSize="18" FontWeight="SemiBold"/><DataGrid ItemsSource="{Binding Suppliers}" SelectedItem="{Binding SelectedSupplier}" AutoGenerateColumns="False" Height="150"><DataGrid.Columns><DataGridTextColumn Header="Company" Binding="{Binding CompanyName}" Width="140"/><DataGridTextColumn Header="Contact" Binding="{Binding ContactPerson}" Width="110"/><DataGridTextColumn Header="Phone" Binding="{Binding Phone}" Width="100"/><DataGridTextColumn Header="Email" Binding="{Binding Email}" Width="150"/><DataGridTextColumn Header="Address" Binding="{Binding Address}" Width="160"/><DataGridTextColumn Header="Tax / Registration" Binding="{Binding TaxRegistrationNumber}" Width="130"/><DataGridTextColumn Header="Notes" Binding="{Binding Notes}" Width="160"/><DataGridCheckBoxColumn Header="Active" Binding="{Binding IsActive}" Width="60"/></DataGrid.Columns></DataGrid><StackPanel Orientation="Horizontal"><Button Content="New Supplier" Command="{Binding NewSupplierCommand}"/><Button Content="Save Supplier" Command="{Binding SaveSupplierCommand}"/></StackPanel></StackPanel></Border>
                        </Grid>
                        <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="Stock movement history" FontSize="18" FontWeight="SemiBold"/><DataGrid ItemsSource="{Binding StockMovements}" IsReadOnly="True" AutoGenerateColumns="False" Height="220"><DataGrid.Columns><DataGridTextColumn Header="Date" Binding="{Binding TransactionDate, StringFormat=g}" Width="130"/><DataGridTextColumn Header="Reference" Binding="{Binding ReferenceNumber}" Width="100"/><DataGridTextColumn Header="Type" Binding="{Binding TransactionType}" Width="145"/><DataGridTextColumn Header="Before" Binding="{Binding QuantityBefore, StringFormat={}{0:0.####}}" Width="75"/><DataGridTextColumn Header="Change" Binding="{Binding QuantityChanged, StringFormat={}{0:0.####}}" Width="75"/><DataGridTextColumn Header="After" Binding="{Binding QuantityAfter, StringFormat={}{0:0.####}}" Width="75"/><DataGridTextColumn Header="Invoice" Binding="{Binding RelatedInvoiceReferenceNumber}" Width="120"/><DataGridTextColumn Header="Operator" Binding="{Binding Operator}" Width="90"/><DataGridTextColumn Header="Notes" Binding="{Binding Notes}" Width="*"/></DataGrid.Columns></DataGrid></StackPanel></Border>
                    </StackPanel>

                    <StackPanel Visibility="{Binding SelectedSection, Converter={StaticResource SectionVisibility}, ConverterParameter=Inventory Reports}">
                        <Border Style="{StaticResource Card}"><WrapPanel><TextBlock Text="From" VerticalAlignment="Center"/><DatePicker SelectedDate="{Binding ReportFrom}"/><TextBlock Text="To" VerticalAlignment="Center"/><DatePicker SelectedDate="{Binding ReportTo}"/><Button Content="Refresh Reports" Command="{Binding RefreshReportsCommand}"/><Button Content="Export Stock CSV" Command="{Binding ExportStockReportCommand}"/><Button Content="Export Profit CSV" Command="{Binding ExportProfitReportCommand}"/></WrapPanel></Border>
                        <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="Current Stock / Low Stock" FontSize="18" FontWeight="SemiBold"/><DataGrid ItemsSource="{Binding CurrentStockReport}" IsReadOnly="True" AutoGenerateColumns="False" Height="260"><DataGrid.Columns><DataGridTextColumn Header="Reference" Binding="{Binding ReferenceNumber}" Width="100"/><DataGridTextColumn Header="Product" Binding="{Binding Product}" Width="*"/><DataGridTextColumn Header="Quantity" Binding="{Binding Quantity, StringFormat={}{0:0.####}}" Width="85"/><DataGridTextColumn Header="Cost" Binding="{Binding CostPrice, StringFormat=N2}" Width="75"/><DataGridTextColumn Header="Selling" Binding="{Binding SellingPrice, StringFormat=N2}" Width="75"/><DataGridTextColumn Header="Cost Value" Binding="{Binding TotalCostValue, StringFormat=N2}" Width="95"/><DataGridTextColumn Header="Potential Value" Binding="{Binding PotentialSellingValue, StringFormat=N2}" Width="105"/><DataGridTextColumn Header="Location" Binding="{Binding StorageLocation}" Width="110"/></DataGrid.Columns></DataGrid></StackPanel></Border>
                        <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="Low-Stock Report" FontSize="18" FontWeight="SemiBold"/><DataGrid ItemsSource="{Binding LowStockReport}" IsReadOnly="True" AutoGenerateColumns="False" Height="180"><DataGrid.Columns><DataGridTextColumn Header="Reference" Binding="{Binding ReferenceNumber}" Width="120"/><DataGridTextColumn Header="Product" Binding="{Binding Product}" Width="*"/><DataGridTextColumn Header="Quantity" Binding="{Binding Quantity, StringFormat={}{0:0.####}}" Width="100"/><DataGridTextColumn Header="Location" Binding="{Binding StorageLocation}" Width="140"/></DataGrid.Columns></DataGrid></StackPanel></Border>
                        <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="Sales and Gross Profit" FontSize="18" FontWeight="SemiBold"/><DataGrid ItemsSource="{Binding SalesProfitReport}" IsReadOnly="True" AutoGenerateColumns="False" Height="300"><DataGrid.Columns><DataGridTextColumn Header="Invoice" Binding="{Binding InvoiceReference}" Width="120"/><DataGridTextColumn Header="Date" Binding="{Binding InvoiceDate, StringFormat=d}" Width="90"/><DataGridTextColumn Header="Product" Binding="{Binding Product}" Width="*"/><DataGridTextColumn Header="Qty" Binding="{Binding QuantitySold, StringFormat={}{0:0.####}}" Width="70"/><DataGridTextColumn Header="Sell" Binding="{Binding SellingPrice, StringFormat=N2}" Width="70"/><DataGridTextColumn Header="Cost" Binding="{Binding CostPrice, StringFormat=N2}" Width="70"/><DataGridTextColumn Header="Revenue" Binding="{Binding Revenue, StringFormat=N2}" Width="80"/><DataGridTextColumn Header="Cost Total" Binding="{Binding Cost, StringFormat=N2}" Width="80"/><DataGridTextColumn Header="Profit" Binding="{Binding GrossProfit, StringFormat=N2}" Width="80"/><DataGridTextColumn Header="Margin %" Binding="{Binding GrossMarginPercentage, StringFormat=N2}" Width="80"/></DataGrid.Columns></DataGrid></StackPanel></Border>
                    </StackPanel>

                    <StackPanel Visibility="{Binding SelectedSection, Converter={StaticResource SectionVisibility}, ConverterParameter=Receipts}">
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="Receipts" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,8" />
                                <TextBlock Text="Create receipts from the invoice list. Linked receipts update invoice payment status automatically." TextWrapping="Wrap" Margin="0,0,0,10" />
                                <DataGrid ItemsSource="{Binding Receipts}">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Reference" Binding="{Binding ReferenceNumber}" Width="140" />
                                        <DataGridTextColumn Header="Date" Binding="{Binding ReceiptDate, StringFormat=d}" Width="100" />
                                        <DataGridTextColumn Header="Customer" Binding="{Binding Customer.Name}" Width="*" />
                                        <DataGridTextColumn Header="Invoice" Binding="{Binding Invoice.ReferenceNumber}" Width="140" />
                                        <DataGridTextColumn Header="Amount" Binding="{Binding PaymentAmount, StringFormat=N2}" Width="100" />
                                        <DataGridTextColumn Header="Method" Binding="{Binding PaymentMethod}" Width="120" />
                                        <DataGridTemplateColumn Header="Actions" Width="105" MinWidth="100">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <Button Content="Actions  &#x25BE;" HorizontalAlignment="Center" VerticalAlignment="Center" MinWidth="88" Padding="10,6"
                                                            Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType=Window}}"
                                                            Click="InvoiceActionsButton_Click" ToolTip="Receipt actions" AutomationProperties.Name="Receipt actions menu">
                                                        <Button.ContextMenu>
                                                            <ContextMenu Style="{StaticResource InvoiceActionsMenu}" Opened="InvoiceActionsMenu_Opened" Closed="InvoiceActionsMenu_Closed">
                                                                <MenuItem Header="Modify Receipt" Style="{StaticResource InvoiceActionMenuItem}"
                                                                          Command="{Binding PlacementTarget.Tag.EditReceiptCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                                          CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}">
                                                                    <MenuItem.Icon><TextBlock Text="&#xE70F;" FontFamily="Segoe MDL2 Assets" Foreground="#176DB5" /></MenuItem.Icon>
                                                                </MenuItem>
                                                                <Separator Margin="5,4" />
                                                                <MenuItem Header="View / Generate Receipt PDF" Style="{StaticResource InvoiceActionMenuItem}"
                                                                          Command="{Binding PlacementTarget.Tag.ExportReceiptPdfCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                                          CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                                                <MenuItem Header="Print Receipt" Style="{StaticResource InvoiceActionMenuItem}"
                                                                          Command="{Binding PlacementTarget.Tag.PrintReceiptCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                                          CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                                                <Separator Margin="5,4" />
                                                                <MenuItem Header="Delete Receipt" Style="{StaticResource InvoiceDeleteMenuItem}"
                                                                          Command="{Binding PlacementTarget.Tag.DeleteReceiptCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                                          CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}">
                                                                    <MenuItem.Icon><TextBlock Text="&#xE74D;" FontFamily="Segoe MDL2 Assets" Foreground="#B91C1C" /></MenuItem.Icon>
                                                                </MenuItem>
                                                            </ContextMenu>
                                                        </Button.ContextMenu>
                                                    </Button>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <StackPanel Visibility="{Binding SelectedSection, Converter={StaticResource SectionVisibility}, ConverterParameter=Reports}">
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="Sales and tax summary" FontSize="18" FontWeight="SemiBold" />
                                <TextBlock Text="{Binding Snapshot.MonthlySales, StringFormat=Monthly sales: {0:N2}}" Margin="0,8,0,0" />
                                <TextBlock Text="{Binding Snapshot.PaymentsReceived, StringFormat=Payments received: {0:N2}}" />
                                <TextBlock Text="{Binding Snapshot.OutstandingAmount, StringFormat=Outstanding balance: {0:N2}}" />
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <StackPanel Visibility="{Binding SelectedSection, Converter={StaticResource SectionVisibility}, ConverterParameter=Backup and Restore}">
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="Create a zip backup of the database, company settings, logo, and saved assets." Margin="0,0,0,6" />
                                <TextBlock Text="Restore replaces the current data from a backup file and creates a safety backup first." Margin="0,0,0,14" />
                                <StackPanel Orientation="Horizontal">
                                    <Button Content="Create Backup" Command="{Binding BackupCommand}" />
                                    <Button Content="Restore Backup" Command="{Binding RestoreCommand}" />
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <StackPanel Visibility="{Binding SelectedSection, Converter={StaticResource SectionVisibility}, ConverterParameter=Company Settings}">
                        <Border Style="{StaticResource Card}">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition /></Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="Company name" /><TextBox Text="{Binding Company.CompanyName}" />
                                    <TextBlock Text="Contact person / owner name" /><TextBox Text="{Binding Company.ContactPersonName}" />
                                    <TextBlock Text="Address" /><TextBox Text="{Binding Company.Address}" />
                                    <TextBlock Text="Telephone" /><TextBox Text="{Binding Company.Telephone}" />
                                    <TextBlock Text="Mobile" /><TextBox Text="{Binding Company.Mobile}" />
                                    <TextBlock Text="Email" /><TextBox Text="{Binding Company.Email}" />
                                    <TextBlock Text="Website" /><TextBox Text="{Binding Company.Website}" />
                                    <TextBlock Text="Logo" /><TextBox Text="{Binding Company.LogoPath}" />
                                    <Button Content="Choose Logo" Command="{Binding ChooseLogoCommand}" HorizontalAlignment="Left" />
                                </StackPanel>
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="Tax ID" /><TextBox Text="{Binding Company.TaxIdentificationNumber}" />
                                    <TextBlock Text="Commercial registration" /><TextBox Text="{Binding Company.CommercialRegistrationNumber}" />
                                    <TextBlock Text="Currency" /><TextBox Text="{Binding Company.Currency}" />
                                    <TextBlock Text="Currency symbol" /><TextBox Text="{Binding Company.CurrencySymbol}" />
                                    <TextBlock Text="Default tax %" /><TextBox Text="{Binding Company.DefaultTaxPercentage}" />
                                    <TextBlock Text="Invoice prefix" /><TextBox Text="{Binding Company.InvoicePrefix}" />
                                    <TextBlock Text="Receipt prefix" /><TextBox Text="{Binding Company.ReceiptPrefix}" />
                                    <TextBlock Text="Footer notes" /><TextBox Text="{Binding Company.InvoiceFooterNotes}" />
                                    <TextBlock Text="Payment terms" /><TextBox Text="{Binding Company.PaymentTerms}" />
                                    <CheckBox Content="Allow Selling When Stock Is Insufficient" IsChecked="{Binding Company.AllowSellingWhenStockIsInsufficient}" Margin="4" />
                                    <Button Content="Save Company Settings" Command="{Binding SaveCompanyCommand}" HorizontalAlignment="Left" />
                                </StackPanel>
                            </Grid>
                        </Border>
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="Quotation Settings" FontSize="18" FontWeight="SemiBold" Foreground="#17365D" Margin="0,0,0,8" />
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                                    <StackPanel Margin="0,0,10,0">
                                        <TextBlock Text="Quotation prefix"/><TextBox Text="{Binding Company.QuotationPrefix}"/>
                                        <TextBlock Text="Starting sequence"/><TextBox Text="{Binding Company.QuotationStartingSequence}"/>
                                        <CheckBox Content="Reset sequence yearly" IsChecked="{Binding Company.ResetQuotationSequenceYearly}"/>
                                        <TextBlock Text="Default validity (days)"/><TextBox Text="{Binding Company.DefaultQuotationValidityDays}"/>
                                        <TextBlock Text="Default tax mode"/><ComboBox SelectedValue="{Binding Company.DefaultQuotationTaxMode}" SelectedValuePath="Content"><ComboBoxItem Content="Exclusive"/><ComboBoxItem Content="Inclusive"/><ComboBoxItem Content="Exempt"/></ComboBox>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Margin="0,0,10,0">
                                        <TextBlock Text="Default payment terms"/><TextBox Text="{Binding Company.DefaultQuotationPaymentTerms}" AcceptsReturn="True" Height="48" TextWrapping="Wrap"/>
                                        <TextBlock Text="Default delivery terms"/><TextBox Text="{Binding Company.DefaultQuotationDeliveryTerms}"/>
                                        <TextBlock Text="Default warranty"/><TextBox Text="{Binding Company.DefaultQuotationWarranty}"/>
                                        <TextBlock Text="Default PDF folder"/><TextBox Text="{Binding Company.DefaultQuotationPdfFolder}"/>
                                        <CheckBox Content="Open PDF after export" IsChecked="{Binding Company.OpenQuotationPdfAfterExport}"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <CheckBox Content="Allow price override" IsChecked="{Binding Company.AllowQuotationPriceOverride}"/>
                                        <CheckBox Content="Allow quotation below cost" IsChecked="{Binding Company.AllowQuotationBelowCost}"/>
                                        <CheckBox Content="Show available stock on screen" IsChecked="{Binding Company.ShowAvailableStockOnQuotationScreen}"/>
                                        <CheckBox Content="Show available stock on printed quotation" IsChecked="{Binding Company.ShowAvailableStockOnPrintedQuotation}"/>
                                        <CheckBox Content="Prevent quantity above available stock" IsChecked="{Binding Company.PreventQuotationAboveAvailableStock}"/>
                                        <TextBlock Text="Quotation footer"/><TextBox Text="{Binding Company.QuotationFooter}" AcceptsReturn="True" Height="55" TextWrapping="Wrap"/>
                                        <TextBlock Text="Terms and conditions"/><TextBox Text="{Binding Company.QuotationTermsAndConditions}" AcceptsReturn="True" Height="70" TextWrapping="Wrap"/>
                                    </StackPanel>
                                </Grid>
                                <Button Content="Save Quotation Settings" Command="{Binding SaveCompanyCommand}" HorizontalAlignment="Left" Margin="0,8,0,0"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <StackPanel Visibility="{Binding SelectedSection, Converter={StaticResource SectionVisibility}, ConverterParameter=Application Settings}">
                        <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                            <StackPanel>
                                <TextBlock Text="License and activation" FontSize="20" FontWeight="SemiBold" Foreground="#17365D" />
                                <TextBlock Text="Invoice Maker is licensed to this computer using the installation ID below." Foreground="#5A6B80" Margin="0,4,0,14" />
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="170" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <TextBlock Text="Application version" FontWeight="SemiBold" Margin="0,4" />
                                    <TextBlock Grid.Column="1" Text="{Binding ApplicationVersion}" Margin="0,4" />
                                    <TextBlock Grid.Row="1" Text="License status" FontWeight="SemiBold" Margin="0,4" />
                                    <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding LicenseStatus}" Margin="0,4" />
                                    <TextBlock Grid.Row="2" Text="Licensed customer" FontWeight="SemiBold" Margin="0,4" />
                                    <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding LicenseCustomer}" Margin="0,4" />
                                    <TextBlock Grid.Row="3" Text="Edition / expiry" FontWeight="SemiBold" Margin="0,4" />
                                    <TextBlock Grid.Row="3" Grid.Column="1" Margin="0,4"><Run Text="{Binding LicenseEdition, Mode=OneWay}"/><Run Text="  •  "/><Run Text="{Binding LicenseExpiry, Mode=OneWay}"/></TextBlock>
                                    <TextBlock Grid.Row="4" Text="Installation ID" FontWeight="SemiBold" Margin="0,4" />
                                    <TextBox Grid.Row="4" Grid.Column="1" Text="{Binding InstallationId, Mode=OneWay}" IsReadOnly="True" FontFamily="Consolas" />
                                    <TextBlock Grid.Row="5" Grid.ColumnSpan="2" Text="{Binding LicenseMessage}" TextWrapping="Wrap" Foreground="#527095" Margin="0,12,0,0" />
                                </Grid>
                                <Button Content="Activate / Replace License" Command="{Binding ActivateLicenseCommand}" HorizontalAlignment="Left" Margin="0,14,0,0" />
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="Database location" FontWeight="SemiBold" />
                                <TextBlock Text="Stored in the current user's local application data folder." />
                                <TextBlock Text="Localization resources are separated so Arabic/right-to-left support can be added later." Margin="0,8,0,0" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>
            </ScrollViewer>
            <Border Grid.Row="2" Background="White" BorderBrush="#DFE7F3" BorderThickness="1" CornerRadius="8" Padding="10" Margin="0,12,0,0">
                <TextBlock Text="{Binding StatusMessage}" Foreground="#0D2B68" />
            </Border>
        </Grid>
    </Grid>
</Window>
