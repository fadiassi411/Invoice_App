<Window x:Class="InvoiceSoftware.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:conv="clr-namespace:InvoiceSoftware.App.Converters"
        xmlns:models="clr-namespace:InvoiceSoftware.Core.Models;assembly=InvoiceSoftware.Core"
        xmlns:sys="clr-namespace:System;assembly=System.Runtime"
        Title="Invoice Management Software"
        Icon="Assets/InvoiceMaker.ico"
        Width="1320" Height="860" MinWidth="1120" MinHeight="720"
        Background="{StaticResource BackgroundBrush}">
    <Window.Resources>
        <conv:SectionVisibilityConverter x:Key="SectionVisibility" />
        <Style x:Key="SidebarSectionLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#6F96C2" />
            <Setter Property="FontSize" Value="10" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="12,13,0,5" />
        </Style>
        <Style x:Key="SidebarListItem" TargetType="ListBoxItem">
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <ContentPresenter />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <DataTemplate x:Key="SidebarNavItemTemplate">
            <Button x:Name="NavButton" Style="{DynamicResource SidebarNavButton}"
                    Command="{Binding DataContext.NavigateCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                    CommandParameter="{Binding}">
                <Grid Height="38">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="34" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border x:Name="NavIconTile" Width="28" Height="28" CornerRadius="8" Background="#153966" VerticalAlignment="Center">
                        <TextBlock x:Name="NavIcon" Text="&#xE10F;" FontFamily="Segoe MDL2 Assets" FontSize="14"
                                   Foreground="#8FB5DA" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <TextBlock Grid.Column="1" Text="{Binding}" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                               FontSize="13" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                </Grid>
            </Button>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding}" Value="Dashboard"><Setter TargetName="NavIcon" Property="Text" Value="&#xE80F;" /></DataTrigger>
                <DataTrigger Binding="{Binding}" Value="Invoices"><Setter TargetName="NavIcon" Property="Text" Value="&#xE8A5;" /></DataTrigger>
                <DataTrigger Binding="{Binding}" Value="Quotations"><Setter TargetName="NavIcon" Property="Text" Value="&#xE8A7;" /></DataTrigger>
                <DataTrigger Binding="{Binding}" Value="Customers"><Setter TargetName="NavIcon" Property="Text" Value="&#xE716;" /></DataTrigger>
                <DataTrigger Binding="{Binding}" Value="Receipts"><Setter TargetName="NavIcon" Property="Text" Value="&#xE8C7;" /></DataTrigger>
                <DataTrigger Binding="{Binding}" Value="Store / Inventory"><Setter TargetName="NavIcon" Property="Text" Value="&#xE7C3;" /></DataTrigger>
                <DataTrigger Binding="{Binding}" Value="Products and Services"><Setter TargetName="NavIcon" Property="Text" Value="&#xE7B8;" /></DataTrigger>
                <DataTrigger Binding="{Binding}" Value="Inventory Reports"><Setter TargetName="NavIcon" Property="Text" Value="&#xE9D2;" /></DataTrigger>
                <DataTrigger Binding="{Binding}" Value="Reports"><Setter TargetName="NavIcon" Property="Text" Value="&#xE9D5;" /></DataTrigger>
                <DataTrigger Binding="{Binding}" Value="Backup and Restore"><Setter TargetName="NavIcon" Property="Text" Value="&#xE74E;" /></DataTrigger>
                <DataTrigger Binding="{Binding}" Value="Company Settings"><Setter TargetName="NavIcon" Property="Text" Value="&#xE719;" /></DataTrigger>
                <DataTrigger Binding="{Binding}" Value="Application Settings"><Setter TargetName="NavIcon" Property="Text" Value="&#xE713;" /></DataTrigger>
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions><Condition Binding="{Binding}" Value="Dashboard"/><Condition Binding="{Binding DataContext.SelectedSection, RelativeSource={RelativeSource AncestorType=Window}}" Value="Dashboard"/></MultiDataTrigger.Conditions>
                    <Setter TargetName="NavButton" Property="Tag" Value="Active"/><Setter TargetName="NavIconTile" Property="Background" Value="#1E83C6"/><Setter TargetName="NavIcon" Property="Foreground" Value="White"/>
                </MultiDataTrigger>
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions><Condition Binding="{Binding}" Value="Invoices"/><Condition Binding="{Binding DataContext.SelectedSection, RelativeSource={RelativeSource AncestorType=Window}}" Value="Invoices"/></MultiDataTrigger.Conditions>
                    <Setter TargetName="NavButton" Property="Tag" Value="Active"/><Setter TargetName="NavIconTile" Property="Background" Value="#1E83C6"/><Setter TargetName="NavIcon" Property="Foreground" Value="White"/>
                </MultiDataTrigger>
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions><Condition Binding="{Binding}" Value="Quotations"/><Condition Binding="{Binding DataContext.SelectedSection, RelativeSource={RelativeSource AncestorType=Window}}" Value="Quotations"/></MultiDataTrigger.Conditions>
                    <Setter TargetName="NavButton" Property="Tag" Value="Active"/><Setter TargetName="NavIconTile" Property="Background" Value="#1E83C6"/><Setter TargetName="NavIcon" Property="Foreground" Value="White"/>
                </MultiDataTrigger>
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions><Condition Binding="{Binding}" Value="Customers"/><Condition Binding="{Binding DataContext.SelectedSection, RelativeSource={RelativeSource AncestorType=Window}}" Value="Customers"/></MultiDataTrigger.Conditions>
                    <Setter TargetName="NavButton" Property="Tag" Value="Active"/><Setter TargetName="NavIconTile" Property="Background" Value="#1E83C6"/><Setter TargetName="NavIcon" Property="Foreground" Value="White"/>
                </MultiDataTrigger>
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions><Condition Binding="{Binding}" Value="Receipts"/><Condition Binding="{Binding DataContext.SelectedSection, RelativeSource={RelativeSource AncestorType=Window}}" Value="Receipts"/></MultiDataTrigger.Conditions>
                    <Setter TargetName="NavButton" Property="Tag" Value="Active"/><Setter TargetName="NavIconTile" Property="Background" Value="#1E83C6"/><Setter TargetName="NavIcon" Property="Foreground" Value="White"/>
                </MultiDataTrigger>
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions><Condition Binding="{Binding}" Value="Store / Inventory"/><Condition Binding="{Binding DataContext.SelectedSection, RelativeSource={RelativeSource AncestorType=Window}}" Value="Store / Inventory"/></MultiDataTrigger.Conditions>
                    <Setter TargetName="NavButton" Property="Tag" Value="Active"/><Setter TargetName="NavIconTile" Property="Background" Value="#1E83C6"/><Setter TargetName="NavIcon" Property="Foreground" Value="White"/>
                </MultiDataTrigger>
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions><Condition Binding="{Binding}" Value="Products and Services"/><Condition Binding="{Binding DataContext.SelectedSection, RelativeSource={RelativeSource AncestorType=Window}}" Value="Products and Services"/></MultiDataTrigger.Conditions>
                    <Setter TargetName="NavButton" Property="Tag" Value="Active"/><Setter TargetName="NavIconTile" Property="Background" Value="#1E83C6"/><Setter TargetName="NavIcon" Property="Foreground" Value="White"/>
                </MultiDataTrigger>
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions><Condition Binding="{Binding}" Value="Inventory Reports"/><Condition Binding="{Binding DataContext.SelectedSection, RelativeSource={RelativeSource AncestorType=Window}}" Value="Inventory Reports"/></MultiDataTrigger.Conditions>
                    <Setter TargetName="NavButton" Property="Tag" Value="Active"/><Setter TargetName="NavIconTile" Property="Background" Value="#1E83C6"/><Setter TargetName="NavIcon" Property="Foreground" Value="White"/>
                </MultiDataTrigger>
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions><Condition Binding="{Binding}" Value="Reports"/><Condition Binding="{Binding DataContext.SelectedSection, RelativeSource={RelativeSource AncestorType=Window}}" Value="Reports"/></MultiDataTrigger.Conditions>
                    <Setter TargetName="NavButton" Property="Tag" Value="Active"/><Setter TargetName="NavIconTile" Property="Background" Value="#1E83C6"/><Setter TargetName="NavIcon" Property="Foreground" Value="White"/>
                </MultiDataTrigger>
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions><Condition Binding="{Binding}" Value="Backup and Restore"/><Condition Binding="{Binding DataContext.SelectedSection, RelativeSource={RelativeSource AncestorType=Window}}" Value="Backup and Restore"/></MultiDataTrigger.Conditions>
                    <Setter TargetName="NavButton" Property="Tag" Value="Active"/><Setter TargetName="NavIconTile" Property="Background" Value="#1E83C6"/><Setter TargetName="NavIcon" Property="Foreground" Value="White"/>
                </MultiDataTrigger>
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions><Condition Binding="{Binding}" Value="Company Settings"/><Condition Binding="{Binding DataContext.SelectedSection, RelativeSource={RelativeSource AncestorType=Window}}" Value="Company Settings"/></MultiDataTrigger.Conditions>
                    <Setter TargetName="NavButton" Property="Tag" Value="Active"/><Setter TargetName="NavIconTile" Property="Background" Value="#1E83C6"/><Setter TargetName="NavIcon" Property="Foreground" Value="White"/>
                </MultiDataTrigger>
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions><Condition Binding="{Binding}" Value="Application Settings"/><Condition Binding="{Binding DataContext.SelectedSection, RelativeSource={RelativeSource AncestorType=Window}}" Value="Application Settings"/></MultiDataTrigger.Conditions>
                    <Setter TargetName="NavButton" Property="Tag" Value="Active"/><Setter TargetName="NavIconTile" Property="Background" Value="#1E83C6"/><Setter TargetName="NavIcon" Property="Foreground" Value="White"/>
                </MultiDataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
        <Style x:Key="SidebarNavList" TargetType="ItemsControl">
            <Setter Property="Margin" Value="0" />
            <Setter Property="ItemTemplate" Value="{StaticResource SidebarNavItemTemplate}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ItemsControl">
                        <ItemsPresenter />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="SidebarNavButton" TargetType="Button">
            <Setter Property="Foreground" Value="#C8DAEC" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="10,2,10,2" />
            <Setter Property="Margin" Value="0,1" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="NavSurface" Background="{TemplateBinding Background}" CornerRadius="9" Padding="{TemplateBinding Padding}">
                            <Grid>
                                <Border x:Name="ActiveMark" Width="3" Height="20" CornerRadius="2" Background="#33D2FF"
                                        HorizontalAlignment="Left" VerticalAlignment="Center" Margin="-10,0,0,0" Opacity="0" />
                                <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center" />
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="NavSurface" Property="Background" Value="#143D70" />
                                <Setter Property="Foreground" Value="White" />
                            </Trigger>
                            <Trigger Property="Tag" Value="Active">
                                <Setter TargetName="NavSurface" Property="Background" Value="#155A94" />
                                <Setter TargetName="ActiveMark" Property="Opacity" Value="1" />
                                <Setter Property="Foreground" Value="White" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="NavSurface" Property="BorderBrush" Value="#65D9FF" />
                                <Setter TargetName="NavSurface" Property="BorderThickness" Value="1" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="QuickCreateButton" TargetType="Button">
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="8" />
            <Setter Property="Margin" Value="3" />
            <Setter Property="MinHeight" Value="64" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="QuickSurface" Background="{TemplateBinding Background}" CornerRadius="11" Padding="{TemplateBinding Padding}"
                                BorderBrush="#35BFEA" BorderThickness="1">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="QuickSurface" Property="Opacity" Value="0.86" /></Trigger>
                            <Trigger Property="IsPressed" Value="True"><Setter TargetName="QuickSurface" Property="Opacity" Value="0.72" /></Trigger>
                            <Trigger Property="IsEnabled" Value="False"><Setter TargetName="QuickSurface" Property="Opacity" Value="0.45" /></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="SidebarScrollBar" TargetType="ScrollBar">
            <Setter Property="Width" Value="7" />
            <Setter Property="Margin" Value="3,2,0,2" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Track x:Name="PART_Track" IsDirectionReversed="True" Focusable="False">
                            <Track.DecreaseRepeatButton>
                                <RepeatButton Command="{x:Static ScrollBar.PageUpCommand}" Opacity="0" Focusable="False" />
                            </Track.DecreaseRepeatButton>
                            <Track.Thumb>
                                <Thumb MinHeight="34">
                                    <Thumb.Template>
                                        <ControlTemplate TargetType="Thumb">
                                            <Border Background="#4877A6" CornerRadius="3" Opacity="0.75" />
                                        </ControlTemplate>
                                    </Thumb.Template>
                                </Thumb>
                            </Track.Thumb>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton Command="{x:Static ScrollBar.PageDownCommand}" Opacity="0" Focusable="False" />
                            </Track.IncreaseRepeatButton>
                        </Track>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="White" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="16" />
            <Setter Property="Margin" Value="6" />
            <Setter Property="BorderBrush" Value="#DFE7F3" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>
        <Style x:Key="DashboardPaymentBadge" TargetType="Border">
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="Padding" Value="8,3" />
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Setter Property="Background" Value="#FEE2E2" />
            <Setter Property="BorderBrush" Value="#FCA5A5" />
            <Setter Property="BorderThickness" Value="1" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding PaymentStatus}" Value="Paid">
                    <Setter Property="Background" Value="#DCFCE7" />
                    <Setter Property="BorderBrush" Value="#86EFAC" />
                </DataTrigger>
                <DataTrigger Binding="{Binding PaymentStatus}" Value="PartiallyPaid">
                    <Setter Property="Background" Value="#FEF3C7" />
                    <Setter Property="BorderBrush" Value="#FCD34D" />
                </DataTrigger>
                <DataTrigger Binding="{Binding PaymentStatus}" Value="Overpaid">
                    <Setter Property="Background" Value="#DBEAFE" />
                    <Setter Property="BorderBrush" Value="#93C5FD" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="DashboardPaymentBadgeText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#991B1B" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding PaymentStatus}" Value="Paid">
                    <Setter Property="Foreground" Value="#166534" />
                </DataTrigger>
                <DataTrigger Binding="{Binding PaymentStatus}" Value="PartiallyPaid">
                    <Setter Property="Foreground" Value="#92400E" />
                </DataTrigger>
                <DataTrigger Binding="{Binding PaymentStatus}" Value="Overpaid">
                    <Setter Property="Foreground" Value="#1E40AF" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="InvoiceNumberCell" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>
        <Style x:Key="InvoiceMoneyCell" TargetType="TextBlock" BasedOn="{StaticResource InvoiceNumberCell}">
            <Setter Property="HorizontalAlignment" Value="Right" />
            <Setter Property="Margin" Value="0,0,8,0" />
        </Style>
        <Style x:Key="InvoiceCenteredCell" TargetType="TextBlock" BasedOn="{StaticResource InvoiceNumberCell}">
            <Setter Property="HorizontalAlignment" Value="Center" />
        </Style>
        <Style x:Key="InvoiceActionsMenu" TargetType="ContextMenu">
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderBrush" Value="#C8D6E8" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="5" />
            <Setter Property="HasDropShadow" Value="True" />
            <Setter Property="MinWidth" Value="245" />
            <Setter Property="Placement" Value="Bottom" />
            <Setter Property="StaysOpen" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ContextMenu">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="7" Padding="{TemplateBinding Padding}">
                            <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Cycle" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="InvoiceActionMenuItem" TargetType="MenuItem">
            <Setter Property="Padding" Value="10,8" />
            <Setter Property="Margin" Value="1" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Foreground" Value="#18314F" />
        </Style>
        <Style x:Key="InvoiceDeleteMenuItem" TargetType="MenuItem" BasedOn="{StaticResource InvoiceActionMenuItem}">
            <Setter Property="Foreground" Value="#B91C1C" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
    </Window.Resources>
    <Window.InputBindings>
        <KeyBinding Key="S" Modifiers="Control" Command="{Binding Quotations.SaveCommand}" />
        <KeyBinding Key="Q" Modifiers="Control+Shift" Command="{Binding Quotations.NewCommand}" />
        <KeyBinding Key="P" Modifiers="Control+Shift" Command="{Binding Quotations.PreviewCommand}" />
    </Window.InputBindings>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="276" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Padding="14,16,14,14" BorderBrush="#17447A" BorderThickness="0,0,1,0">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0.9,1">
                    <GradientStop Color="#081D46" Offset="0" />
                    <GradientStop Color="#0D2B68" Offset="0.52" />
                    <GradientStop Color="#103B72" Offset="1" />
                </LinearGradientBrush>
            </Border.Background>
            <DockPanel>
                <StackPanel DockPanel.Dock="Top" Margin="4,0,4,9">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="54"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <Border Width="48" Height="48" CornerRadius="14" Background="#F7FBFF" BorderBrush="#2BB7E8" BorderThickness="1" ClipToBounds="True">
                            <Image Source="{Binding Company.LogoPath}" Width="180" Height="60" Stretch="Fill"
                                   HorizontalAlignment="Left" VerticalAlignment="Center" />
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="9,0,0,0">
                            <TextBlock Text="{Binding Company.CompanyName}" Foreground="White" FontSize="14.5" FontWeight="SemiBold"
                                       TextWrapping="Wrap" MaxHeight="42" TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="Business control center" Foreground="#8EB1D4" FontSize="11" Margin="0,3,0,0" />
                        </StackPanel>
                    </Grid>
                    <Border Background="#102F5B" BorderBrush="#1C5689" BorderThickness="1" CornerRadius="7" Padding="8,5" Margin="0,12,0,0">
                        <DockPanel>
                            <Ellipse Width="7" Height="7" Fill="#36D2F2" Margin="0,0,7,0" VerticalAlignment="Center" />
                            <TextBlock Text="INVOICE WORKSPACE" Foreground="#A9CBE8" FontSize="9.5" FontWeight="SemiBold" VerticalAlignment="Center" />
                        </DockPanel>
                    </Border>
                </StackPanel>
                <Border DockPanel.Dock="Bottom" Background="#0A2450" BorderBrush="#1A4A7D" BorderThickness="1" CornerRadius="9" Padding="10,8" Margin="4,10,4,0">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="28"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <TextBlock Text="&#xE73E;" FontFamily="Segoe MDL2 Assets" FontSize="14" Foreground="#41C9EC" VerticalAlignment="Center" />
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="Business workspace" Foreground="#D5E5F4" FontSize="11" FontWeight="SemiBold" />
                            <TextBlock Text="Invoices • Stock • Reports" Foreground="#7397BC" FontSize="9.5" Margin="0,2,0,0" />
                        </StackPanel>
                    </Grid>
                </Border>
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <ScrollViewer.Resources>
                        <Style TargetType="ScrollBar" BasedOn="{StaticResource SidebarScrollBar}" />
                    </ScrollViewer.Resources>
                    <StackPanel>
                        <TextBlock Text="QUICK CREATE" Style="{StaticResource SidebarSectionLabel}" Margin="12,4,0,5" />
                        <UniformGrid Columns="2">
                            <Button Style="{StaticResource QuickCreateButton}" Background="#167FC1" Command="{Binding NewInvoiceCommand}"
                                    ToolTip="Create a new invoice" AutomationProperties.Name="Create new invoice">
                                <StackPanel>
                                    <TextBlock Text="&#xE710;" FontFamily="Segoe MDL2 Assets" FontSize="18" HorizontalAlignment="Center" />
                                    <TextBlock Text="New Invoice" FontSize="11.5" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,5,0,0" />
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource QuickCreateButton}" Background="#147F8C" Command="{Binding Quotations.NewCommand}"
                                    ToolTip="Create a new quotation" AutomationProperties.Name="Create new quotation">
                                <StackPanel>
                                    <TextBlock Text="&#xE8A7;" FontFamily="Segoe MDL2 Assets" FontSize="18" HorizontalAlignment="Center" />
                                    <TextBlock Text="New Quotation" FontSize="11.5" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,5,0,0" />
                                </StackPanel>
                            </Button>
                        </UniformGrid>

                        <TextBlock Text="OVERVIEW" Style="{StaticResource SidebarSectionLabel}" />
                        <ItemsControl Style="{StaticResource SidebarNavList}">
                            <sys:String>Dashboard</sys:String>
                        </ItemsControl>

                        <TextBlock Text="SALES" Style="{StaticResource SidebarSectionLabel}" />
                        <ItemsControl Style="{StaticResource SidebarNavList}">
                            <sys:String>Invoices</sys:String>
                            <sys:String>Quotations</sys:String>
                            <sys:String>Customers</sys:String>
                            <sys:String>Receipts</sys:String>
                        </ItemsControl>

                        <TextBlock Text="INVENTORY" Style="{StaticResource SidebarSectionLabel}" />
                        <ItemsControl Style="{StaticResource SidebarNavList}">
                            <sys:String>Store / Inventory</sys:String>
                            <sys:String>Products and Services</sys:String>
                            <sys:String>Inventory Reports</sys:String>
                        </ItemsControl>

                        <TextBlock Text="INSIGHTS" Style="{StaticResource SidebarSectionLabel}" />
                        <ItemsControl Style="{StaticResource SidebarNavList}">
                            <sys:String>Reports</sys:String>
                        </ItemsControl>

                        <TextBlock Text="SYSTEM" Style="{StaticResource SidebarSectionLabel}" />
                        <ItemsControl Style="{StaticResource SidebarNavList}">
                            <sys:String>Backup and Restore</sys:String>
                            <sys:String>Company Settings</sys:String>
                            <sys:String>Application Settings</sys:String>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>
            </DockPanel>
        </Border>

        <Grid Grid.Column="1" Margin="18">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <DockPanel Grid.Row="0" Margin="0,0,0,12">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <TextBox Width="240" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" ToolTip="{Binding GlobalSearchHint}">
                        <TextBox.InputBindings>
                            <KeyBinding Key="Enter" Command="{Binding SearchCommand}" />
                        </TextBox.InputBindings>
                    </TextBox>
                    <Button Content="Search" Command="{Binding SearchCommand}" ToolTip="{Binding GlobalSearchHint}" />
                    <Button Content="New Invoice" Command="{Binding NewInvoiceCommand}" />
                    <Button Content="New Quotation" Command="{Binding Quotations.NewCommand}" />
                </StackPanel>
                <TextBlock Text="{Binding SelectedSection}" FontSize="26" FontWeight="SemiBold" Foreground="#0D2B68" VerticalAlignment="Center" />
            </DockPanel>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                <Grid>
                    <StackPanel Visibility="{Binding SelectedSection, Converter={StaticResource SectionVisibility}, ConverterParameter=Dashboard}">
                        <UniformGrid Columns="4">
                            <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="Total invoices" /><TextBlock Text="{Binding Snapshot.TotalInvoices}" FontSize="24" FontWeight="Bold" /></StackPanel></Border>
                            <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="Created today" /><TextBlock Text="{Binding Snapshot.InvoicesToday}" FontSize="24" FontWeight="Bold" /></StackPanel></Border>
                            <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="Monthly sales" /><TextBlock Text="{Binding Snapshot.MonthlySales, StringFormat=N2}" FontSize="24" FontWeight="Bold" /></StackPanel></Border>
                            <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="Outstanding" /><TextBlock Text="{Binding Snapshot.OutstandingAmount, StringFormat=N2}" FontSize="24" FontWeight="Bold" /></StackPanel></Border>
                            <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="Paid" /><TextBlock Text="{Binding Snapshot.PaidInvoices}" FontSize="24" FontWeight="Bold" /></StackPanel></Border>
                            <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="Partial" /><TextBlock Text="{Binding Snapshot.PartiallyPaidInvoices}" FontSize="24" FontWeight="Bold" /></StackPanel></Border>
                            <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="Unpaid" /><TextBlock Text="{Binding Snapshot.UnpaidInvoices}" FontSize="24" FontWeight="Bold" /></StackPanel></Border>
                            <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="Overdue" /><TextBlock Text="{Binding Snapshot.OverdueInvoices}" FontSize="24" FontWeight="Bold" /></StackPanel></Border>
                            <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="Active products" /><TextBlock Text="{Binding Snapshot.TotalActiveProducts}" FontSize="24" FontWeight="Bold" /></StackPanel></Border>
                            <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="Stock quantity" /><TextBlock Text="{Binding Snapshot.TotalQuantityInStock, StringFormat={}{0:0.####}}" FontSize="24" FontWeight="Bold" /></StackPanel></Border>
                            <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="Inventory cost value" /><TextBlock Text="{Binding Snapshot.TotalInventoryCostValue, StringFormat=N2}" FontSize="24" FontWeight="Bold" /></StackPanel></Border>
                            <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="Low / out of stock" /><TextBlock FontSize="24" FontWeight="Bold"><Run Text="{Binding Snapshot.LowStockProducts, Mode=OneWay}"/><Run Text=" / "/><Run Text="{Binding Snapshot.OutOfStockProducts, Mode=OneWay}"/></TextBlock></StackPanel></Border>
                            <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="Sales today" /><TextBlock Text="{Binding Snapshot.SalesToday, StringFormat=N2}" FontSize="24" FontWeight="Bold" /></StackPanel></Border>
                            <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="Gross profit today" /><TextBlock Text="{Binding Snapshot.GrossProfitToday, StringFormat=N2}" FontSize="24" FontWeight="Bold" /></StackPanel></Border>
                        </UniformGrid>
                        <Grid Margin="0,4,0,0">
                            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Style="{StaticResource Card}" MinHeight="220">
                                <StackPanel>
                                    <DockPanel Margin="0,0,0,8">
                                        <Border DockPanel.Dock="Right" Background="#E7F3FC" CornerRadius="7" Padding="8,4">
                                            <TextBlock Text="LAST 12 MONTHS" Foreground="#176AA5" FontSize="9.5" FontWeight="SemiBold" />
                                        </Border>
                                        <StackPanel>
                                            <TextBlock Text="Sales by month" FontSize="18" FontWeight="SemiBold" Foreground="#17365D" />
                                            <TextBlock Text="Finalized invoice totals" Foreground="#6B7C93" FontSize="11" Margin="0,2,0,0" />
                                        </StackPanel>
                                    </DockPanel>
                                    <Grid Height="145">
                                        <Border BorderBrush="#E6EDF6" BorderThickness="0,0,0,1" VerticalAlignment="Bottom" Margin="0,0,0,22" />
                                        <ItemsControl ItemsSource="{Binding Snapshot.MonthlySalesTrend}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate><UniformGrid Rows="1"/></ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Grid Margin="2,0">
                                                        <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="22"/></Grid.RowDefinitions>
                                                        <Border Grid.Row="0" Width="18" Height="{Binding BarHeight}" VerticalAlignment="Bottom"
                                                                Background="#2489CA" CornerRadius="5,5,2,2" ToolTipService.ShowDuration="10000">
                                                            <Border.ToolTip>
                                                                <StackPanel>
                                                                    <TextBlock Text="{Binding Period}" FontWeight="SemiBold" />
                                                                    <TextBlock Text="{Binding Amount, StringFormat=Sales: {0:N2}}" Margin="0,2,0,0" />
                                                                </StackPanel>
                                                            </Border.ToolTip>
                                                        </Border>
                                                        <TextBlock Grid.Row="1" Text="{Binding Label}" HorizontalAlignment="Center" VerticalAlignment="Bottom"
                                                                   Foreground="#607089" FontSize="10" />
                                                    </Grid>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </Grid>
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="1" Style="{StaticResource Card}" MinHeight="220">
                                <StackPanel>
                                    <DockPanel Margin="0,0,0,8">
                                        <Border DockPanel.Dock="Right" Background="#E5F6F4" CornerRadius="7" Padding="8,4">
                                            <TextBlock Text="LAST 5 YEARS" Foreground="#147B77" FontSize="9.5" FontWeight="SemiBold" />
                                        </Border>
                                        <StackPanel>
                                            <TextBlock Text="Sales by year" FontSize="18" FontWeight="SemiBold" Foreground="#17365D" />
                                            <TextBlock Text="Finalized invoice totals" Foreground="#6B7C93" FontSize="11" Margin="0,2,0,0" />
                                        </StackPanel>
                                    </DockPanel>
                                    <Grid Height="145">
                                        <Border BorderBrush="#E6EDF6" BorderThickness="0,0,0,1" VerticalAlignment="Bottom" Margin="0,0,0,22" />
                                        <ItemsControl ItemsSource="{Binding Snapshot.YearlySalesTrend}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate><UniformGrid Rows="1"/></ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Grid Margin="7,0">
                                                        <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="22"/></Grid.RowDefinitions>
                                                        <Border Grid.Row="0" Width="32" Height="{Binding BarHeight}" VerticalAlignment="Bottom"
                                                                Background="#16928F" CornerRadius="6,6,2,2" ToolTipService.ShowDuration="10000">
                                                            <Border.ToolTip>
                                                                <StackPanel>
                                                                    <TextBlock Text="{Binding Period}" FontWeight="SemiBold" />
                                                                    <TextBlock Text="{Binding Amount, StringFormat=Sales: {0:N2}}" Margin="0,2,0,0" />
                                                                </StackPanel>
                                                            </Border.ToolTip>
                                                        </Border>
                                                        <TextBlock Grid.Row="1" Text="{Binding Label}" HorizontalAlignment="Center" VerticalAlignment="Bottom"
                                                                   Foreground="#607089" FontSize="10" />
                                                    </Grid>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </StackPanel>

                    <StackPanel Visibility="{Binding SelectedSection, Converter={StaticResource SectionVisibility}, ConverterParameter=New Invoice}">
                        <Border Style="{StaticResource Card}">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition /><ColumnDefinition /></Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="Customer" FontWeight="SemiBold" />
                                    <ComboBox ItemsSource="{Binding Customers}" SelectedItem="{Binding SelectedCustomer}" DisplayMemberPath="Name" />
                                    <TextBlock Text="Invoice #" FontWeight="SemiBold" />
                                    <TextBox Text="{Binding SelectedInvoice.ReferenceNumber, Mode=OneWay}" IsReadOnly="True" FontWeight="SemiBold" Background="#F3F7FC" />
                                </StackPanel>
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="Invoice date" FontWeight="SemiBold" />
                                    <DatePicker SelectedDate="{Binding SelectedInvoice.InvoiceDate}" />
                                    <TextBlock Text="Due date" FontWeight="SemiBold" />
                                    <DatePicker SelectedDate="{Binding SelectedInvoice.DueDate}" />
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Payment method" FontWeight="SemiBold" />
                                    <TextBox Text="{Binding SelectedInvoice.PaymentMethod}" />
                                    <TextBlock Text="Notes" FontWeight="SemiBold" />
                                    <TextBox Text="{Binding SelectedInvoice.Notes}" Height="64" TextWrapping="Wrap" AcceptsReturn="True" />
                                </StackPanel>
                            </Grid>
                        </Border>
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <DockPanel Margin="0,0,0,8">
                                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                        <Button Content="Find Product..." Command="{Binding SelectProductCommand}" ToolTip="Search by reference, barcode, name, or description" />
                                        <Button Content="Add Custom Row" Command="{Binding AddInvoiceRowCommand}" />
                                        <Button Content="Save Invoice" Command="{Binding SaveInvoiceCommand}" />
                                    </StackPanel>
                                    <TextBlock Text="Invoice items" FontSize="18" FontWeight="SemiBold" />
                                </DockPanel>
                                <DataGrid ItemsSource="{Binding InvoiceItems}">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="#" Binding="{Binding SortOrder}" Width="45" />
                                        <DataGridTextColumn Header="Description" Binding="{Binding Description}" Width="*" />
                                        <DataGridTextColumn Header="Qty" Binding="{Binding Quantity}" Width="70" />
                                        <DataGridTextColumn Header="Unit" Binding="{Binding Unit}" Width="70" />
                                        <DataGridTextColumn Header="Price" Binding="{Binding UnitPrice}" Width="90" />
                                        <DataGridTextColumn Header="Disc %" Binding="{Binding DiscountPercentage}" Width="80" />
                                        <DataGridTextColumn Header="Tax %" Binding="{Binding TaxPercentage}" Width="80" />
                                        <DataGridTemplateColumn Header="Action" Width="90">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <Button Content="Remove" Command="{Binding DataContext.RemoveInvoiceRowCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" />
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <StackPanel Visibility="{Binding SelectedSection, Converter={StaticResource SectionVisibility}, ConverterParameter=Invoices}">
                        <Border Style="{StaticResource Card}">
                            <DataGrid ItemsSource="{Binding Invoices}" SelectedItem="{Binding SelectedInvoice}" RowHeight="44" MinColumnWidth="70" HorizontalScrollBarVisibility="Auto">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Reference" Binding="{Binding ReferenceNumber}" Width="155" MinWidth="145" ElementStyle="{StaticResource InvoiceNumberCell}" />
                                    <DataGridTextColumn Header="Customer" Binding="{Binding CustomerNameSnapshot}" Width="*" MinWidth="190" ElementStyle="{StaticResource InvoiceNumberCell}" />
                                    <DataGridTextColumn Header="Date" Binding="{Binding InvoiceDate, StringFormat=d}" Width="95" MinWidth="90" ElementStyle="{StaticResource InvoiceCenteredCell}" />
                                    <DataGridTextColumn Header="Due Date" Binding="{Binding DueDate, StringFormat=d}" Width="95" MinWidth="90" ElementStyle="{StaticResource InvoiceCenteredCell}" />
                                    <DataGridTextColumn Header="Total" Binding="{Binding GrandTotal, StringFormat=N2}" Width="90" MinWidth="82" ElementStyle="{StaticResource InvoiceMoneyCell}" />
                                    <DataGridTextColumn Header="Paid" Binding="{Binding AmountPaid, StringFormat=N2}" Width="90" MinWidth="82" ElementStyle="{StaticResource InvoiceMoneyCell}" />
                                    <DataGridTextColumn Header="Balance" Binding="{Binding RemainingBalance, StringFormat=N2}" Width="90" MinWidth="82" ElementStyle="{StaticResource InvoiceMoneyCell}" />
                                    <DataGridTextColumn Header="Status" Binding="{Binding PaymentStatus}" Width="105" MinWidth="95" ElementStyle="{StaticResource InvoiceCenteredCell}" />
                                    <DataGridTemplateColumn Header="Actions" Width="105" MinWidth="100">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Button Content="Actions  ▾" HorizontalAlignment="Center" VerticalAlignment="Center" MinWidth="88" Padding="10,6"
                                                        Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType=Window}}"
                                                        Click="InvoiceActionsButton_Click" ToolTip="Invoice actions" AutomationProperties.Name="Invoice actions menu">
                                                    <Button.ContextMenu>
                                                        <ContextMenu Style="{StaticResource InvoiceActionsMenu}" Opened="InvoiceActionsMenu_Opened" Closed="InvoiceActionsMenu_Closed">
                                                            <MenuItem Header="Modify Invoice" Style="{StaticResource InvoiceActionMenuItem}"
                                                                      Command="{Binding PlacementTarget.Tag.EditInvoiceCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                                      CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}">
                                                                <MenuItem.Icon><TextBlock Text="&#xE70F;" FontFamily="Segoe MDL2 Assets" Foreground="#176DB5" /></MenuItem.Icon>
                                                            </MenuItem>
                                                            <Separator Margin="5,4" />
                                                            <MenuItem Header="View / Generate Invoice PDF" Style="{StaticResource InvoiceActionMenuItem}"
                                                                      Command="{Binding PlacementTarget.Tag.ExportInvoicePdfCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                                      CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}">
                                                                <MenuItem.Icon><TextBlock Text="▣" Foreground="#176DB5" /></MenuItem.Icon>
                                                            </MenuItem>
                                                            <MenuItem Header="Print Invoice" Style="{StaticResource InvoiceActionMenuItem}"
                                                                      Command="{Binding PlacementTarget.Tag.PrintInvoiceCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                                      CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}">
                                                                <MenuItem.Icon><TextBlock Text="▤" Foreground="#176DB5" /></MenuItem.Icon>
                                                            </MenuItem>
                                                            <MenuItem Header="Create Receipt" Style="{StaticResource InvoiceActionMenuItem}"
                                                                      Command="{Binding PlacementTarget.Tag.CreateReceiptCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                                      CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}">
                                                                <MenuItem.Icon><TextBlock Text="＋" Foreground="#176DB5" /></MenuItem.Icon>
                                                            </MenuItem>
                                                            <MenuItem Header="View / Generate Receipt PDF" Style="{StaticResource InvoiceActionMenuItem}"
                                                                      Command="{Binding PlacementTarget.Tag.ExportReceiptForInvoiceCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                                      CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}">
                                                                <MenuItem.Icon><TextBlock Text="▣" Foreground="#176DB5" /></MenuItem.Icon>
                                                            </MenuItem>
                                                            <MenuItem Header="Mark as Paid" Style="{StaticResource InvoiceActionMenuItem}"
                                                                      Command="{Binding PlacementTarget.Tag.MarkPaidCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                                      CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}">
                                                                <MenuItem.Icon><TextBlock Text="✓" Foreground="#15803D" FontWeight="Bold" /></MenuItem.Icon>
                                                            </MenuItem>
                                                            <Separator Margin="5,4" />
                                                            <MenuItem Header="Delete Invoice" Style="{StaticResource InvoiceDeleteMenuItem}"
                                                                      Command="{Binding PlacementTarget.Tag.DeleteInvoiceCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                                      CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}">
                                                                <MenuItem.Icon><TextBlock Text="×" Foreground="#B91C1C" FontWeight="Bold" /></MenuItem.Icon>
                                                            </MenuItem>
                                                        </ContextMenu>
                                                    </Button.ContextMenu>
                                                </Button>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Border>
                    </StackPanel>

                    <StackPanel DataContext="{Binding Quotations}" PreviewKeyUp="QuotationEditor_Changed"
                                Visibility="{Binding DataContext.SelectedSection, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource SectionVisibility}, ConverterParameter=New Quotation}">
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <DockPanel Margin="0,0,0,8">
                                    <TextBlock Text="Quotation workspace" FontSize="20" FontWeight="SemiBold" Foreground="#17365D" VerticalAlignment="Center" />
                                    <WrapPanel DockPanel.Dock="Right" HorizontalAlignment="Right">
                                        <Button Content="Document  ▾" MinWidth="118" Tag="{Binding}" Click="InvoiceActionsButton_Click" ToolTip="Create, save, revise, or close">
                                            <Button.ContextMenu>
                                                <ContextMenu Style="{StaticResource InvoiceActionsMenu}" Opened="InvoiceActionsMenu_Opened" Closed="InvoiceActionsMenu_Closed">
                                                    <MenuItem Header="New Quotation" Style="{StaticResource InvoiceActionMenuItem}" Command="{Binding PlacementTarget.Tag.NewCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                                    <Separator Margin="5,4" />
                                                    <MenuItem Header="Save" Style="{StaticResource InvoiceActionMenuItem}" Command="{Binding PlacementTarget.Tag.SaveCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                                    <MenuItem Header="Save and Preview" Style="{StaticResource InvoiceActionMenuItem}" Command="{Binding PlacementTarget.Tag.SaveAndPreviewCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                                    <MenuItem Header="Create Revision" Style="{StaticResource InvoiceActionMenuItem}" Command="{Binding PlacementTarget.Tag.CreateRevisionCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="{Binding PlacementTarget.Tag.CurrentQuotation, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                                    <Separator Margin="5,4" />
                                                    <MenuItem Header="Close Workspace" Style="{StaticResource InvoiceActionMenuItem}" Command="{Binding PlacementTarget.Tag.CloseEditorCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                                </ContextMenu>
                                            </Button.ContextMenu>
                                        </Button>
                                        <Button Content="Output  ▾" MinWidth="108" Tag="{Binding}" Click="InvoiceActionsButton_Click" ToolTip="Preview, print, or export PDF">
                                            <Button.ContextMenu>
                                                <ContextMenu Style="{StaticResource InvoiceActionsMenu}" Opened="InvoiceActionsMenu_Opened" Closed="InvoiceActionsMenu_Closed">
                                                    <MenuItem Header="Preview Quotation" Style="{StaticResource InvoiceActionMenuItem}" Command="{Binding PlacementTarget.Tag.PreviewCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                                    <MenuItem Header="Print Quotation" Style="{StaticResource InvoiceActionMenuItem}" Command="{Binding PlacementTarget.Tag.PrintCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                                    <MenuItem Header="Export PDF" Style="{StaticResource InvoiceActionMenuItem}" Command="{Binding PlacementTarget.Tag.ExportPdfCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                                </ContextMenu>
                                            </Button.ContextMenu>
                                        </Button>
                                        <Button Content="Workflow  ▾" MinWidth="118" Tag="{Binding}" Click="InvoiceActionsButton_Click" Background="#1E7480" ToolTip="Change status or convert to invoice">
                                            <Button.ContextMenu>
                                                <ContextMenu Style="{StaticResource InvoiceActionsMenu}" Opened="InvoiceActionsMenu_Opened" Closed="InvoiceActionsMenu_Closed">
                                                    <MenuItem Header="Mark as Sent" Style="{StaticResource InvoiceActionMenuItem}" Command="{Binding PlacementTarget.Tag.ChangeStatusCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="{x:Static models:QuotationStatus.Sent}" />
                                                    <MenuItem Header="Mark Under Review" Style="{StaticResource InvoiceActionMenuItem}" Command="{Binding PlacementTarget.Tag.ChangeStatusCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="{x:Static models:QuotationStatus.UnderReview}" />
                                                    <MenuItem Header="Mark Accepted" Style="{StaticResource InvoiceActionMenuItem}" Command="{Binding PlacementTarget.Tag.ChangeStatusCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="{x:Static models:QuotationStatus.Accepted}" />
                                                    <MenuItem Header="Mark Rejected" Style="{StaticResource InvoiceActionMenuItem}" Command="{Binding PlacementTarget.Tag.ChangeStatusCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="{x:Static models:QuotationStatus.Rejected}" />
                                                    <Separator Margin="5,4" />
                                                    <MenuItem Header="Convert to Invoice" Style="{StaticResource InvoiceActionMenuItem}" Command="{Binding PlacementTarget.Tag.ConvertToInvoiceCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="{Binding PlacementTarget.Tag.CurrentQuotation, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                                    <MenuItem Header="Cancel Quotation" Style="{StaticResource InvoiceDeleteMenuItem}" Command="{Binding PlacementTarget.Tag.ChangeStatusCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="{x:Static models:QuotationStatus.Cancelled}" />
                                                </ContextMenu>
                                            </Button.ContextMenu>
                                        </Button>
                                    </WrapPanel>
                                </DockPanel>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="Customer and quotation information" FontSize="17" FontWeight="SemiBold" Margin="0,0,0,8" />
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                                    <StackPanel Margin="0,0,8,0">
                                        <TextBlock Text="Customer *" FontWeight="SemiBold" />
                                        <ComboBox ItemsSource="{Binding Customers}" SelectedItem="{Binding SelectedCustomer}" DisplayMemberPath="Name" />
                                        <Button Content="Apply Customer" Command="{Binding ApplyCustomerCommand}" HorizontalAlignment="Left" ToolTip="Store the selected customer details in this quotation" />
                                        <TextBlock Text="Quotation number" FontWeight="SemiBold" />
                                        <TextBox Text="{Binding CurrentQuotation.QuotationNumber, Mode=OneWay}" IsReadOnly="True" Background="#F3F7FC" FontWeight="SemiBold" />
                                        <TextBlock Text="Revision" /><TextBox Text="{Binding CurrentQuotation.RevisionNumber, Mode=OneWay}" IsReadOnly="True" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Margin="0,0,8,0">
                                        <TextBlock Text="Quotation date *" /><DatePicker SelectedDate="{Binding CurrentQuotation.QuotationDate}" />
                                        <TextBlock Text="Valid until *" /><DatePicker SelectedDate="{Binding CurrentQuotation.ValidUntil}" />
                                        <TextBlock Text="Status" /><TextBox Text="{Binding CurrentQuotation.Status, Mode=OneWay}" IsReadOnly="True" />
                                        <TextBlock Text="Customer enquiry / reference" /><TextBox Text="{Binding CurrentQuotation.CustomerReference, UpdateSourceTrigger=PropertyChanged}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" Margin="0,0,8,0">
                                        <TextBlock Text="Project name" /><TextBox Text="{Binding CurrentQuotation.ProjectName, UpdateSourceTrigger=PropertyChanged}" />
                                        <TextBlock Text="Project location" /><TextBox Text="{Binding CurrentQuotation.ProjectLocation, UpdateSourceTrigger=PropertyChanged}" />
                                        <TextBlock Text="Subject" /><TextBox Text="{Binding CurrentQuotation.Subject, UpdateSourceTrigger=PropertyChanged}" />
                                        <TextBlock Text="Salesperson" /><TextBox Text="{Binding CurrentQuotation.Salesperson, UpdateSourceTrigger=PropertyChanged}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="3">
                                        <TextBlock Text="Currency" /><TextBox Text="{Binding CurrentQuotation.CurrencyCode, UpdateSourceTrigger=PropertyChanged}" />
                                        <TextBlock Text="Exchange rate" /><TextBox Text="{Binding CurrentQuotation.ExchangeRate, UpdateSourceTrigger=PropertyChanged}" />
                                        <TextBlock Text="Tax mode" /><ComboBox ItemsSource="{Binding TaxModes}" SelectedItem="{Binding CurrentQuotation.TaxMode}" />
                                        <TextBlock Text="Contact person" /><TextBox Text="{Binding CurrentQuotation.ContactPersonSnapshot, UpdateSourceTrigger=PropertyChanged}" />
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <DockPanel Margin="0,0,0,8">
                                    <TextBlock Text="Quotation items" FontSize="17" FontWeight="SemiBold" VerticalAlignment="Center" />
                                    <WrapPanel DockPanel.Dock="Right">
                                        <Button Content="Item Actions  ▾" MinWidth="132" Tag="{Binding}" Click="InvoiceActionsButton_Click" ToolTip="Add quotation rows or recalculate totals">
                                            <Button.ContextMenu>
                                                <ContextMenu Style="{StaticResource InvoiceActionsMenu}" Opened="InvoiceActionsMenu_Opened" Closed="InvoiceActionsMenu_Closed">
                                                    <MenuItem Header="Find Stock Item..." Style="{StaticResource InvoiceActionMenuItem}" Command="{Binding PlacementTarget.Tag.AddStockItemCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                                    <MenuItem Header="Add Manual Item" Style="{StaticResource InvoiceActionMenuItem}" Command="{Binding PlacementTarget.Tag.AddManualItemCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                                    <MenuItem Header="Add Service / Labour" Style="{StaticResource InvoiceActionMenuItem}" Command="{Binding PlacementTarget.Tag.AddServiceCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                                    <MenuItem Header="Add Section Header" Style="{StaticResource InvoiceActionMenuItem}" Command="{Binding PlacementTarget.Tag.AddSectionCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                                    <Separator Margin="5,4" />
                                                    <MenuItem Header="Recalculate Totals" Style="{StaticResource InvoiceActionMenuItem}" Command="{Binding PlacementTarget.Tag.RecalculateCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                                </ContextMenu>
                                            </Button.ContextMenu>
                                        </Button>
                                    </WrapPanel>
                                </DockPanel>
                                <CheckBox Content="PDF: show total price only (hide item prices)"
                                          IsChecked="{Binding CurrentQuotation.HideItemPricesOnPdf, UpdateSourceTrigger=PropertyChanged}"
                                          Click="QuotationPdfOption_Click" Margin="0,0,0,8"
                                          ToolTip="The PDF hides line prices and the subtotal breakdown; only the grand total remains." />
                                <DataGrid x:Name="QuotationItemsGrid" ItemsSource="{Binding Items}" SelectedItem="{Binding SelectedLine}"
                                          AutoGenerateColumns="False" CanUserAddRows="False" Height="310" HorizontalScrollBarVisibility="Auto"
                                          CellEditEnding="QuotationItemsGrid_CellEditEnding" IsReadOnly="False">
                                    <DataGrid.RowStyle>
                                        <Style TargetType="DataGridRow">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding ItemType}" Value="SectionHeader">
                                                    <Setter Property="Background" Value="#DCE8F0"/><Setter Property="FontWeight" Value="SemiBold"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </DataGrid.RowStyle>
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="#" Binding="{Binding LineNumber}" IsReadOnly="True" Width="38" />
                                        <DataGridTextColumn Header="Reference" Binding="{Binding ItemReferenceSnapshot}" Width="95" />
                                        <DataGridTextColumn Header="Part No." Binding="{Binding PartNumberSnapshot}" Width="95" />
                                        <DataGridTextColumn Header="Description" Binding="{Binding DescriptionSnapshot, UpdateSourceTrigger=PropertyChanged}" Width="260" />
                                        <DataGridTextColumn Header="Qty" Binding="{Binding Quantity, UpdateSourceTrigger=PropertyChanged}" Width="65" />
                                        <DataGridTextColumn Header="Unit" Binding="{Binding UnitSnapshot, UpdateSourceTrigger=PropertyChanged}" Width="55" />
                                        <DataGridTextColumn Header="Available" Binding="{Binding AvailableStockSnapshot, StringFormat={}{0:0.####}}" IsReadOnly="True" Width="75" />
                                        <DataGridTextColumn Header="Unit Price" Binding="{Binding UnitPrice, UpdateSourceTrigger=PropertyChanged, StringFormat=N2}" Width="82" />
                                        <DataGridTemplateColumn Header="Disc. Type" Width="110">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <ComboBox ItemsSource="{Binding DataContext.DiscountTypes, RelativeSource={RelativeSource AncestorType=DataGrid}}" SelectedItem="{Binding DiscountType}" Padding="2" Margin="0" />
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                        <DataGridTextColumn Header="Disc. Value" Binding="{Binding DiscountValue, UpdateSourceTrigger=PropertyChanged}" Width="80" />
                                        <DataGridTextColumn Header="Discount" Binding="{Binding DiscountAmount, StringFormat=N2}" IsReadOnly="True" Width="78" />
                                        <DataGridTextColumn Header="Tax %" Binding="{Binding TaxPercentage, UpdateSourceTrigger=PropertyChanged}" Width="60" />
                                        <DataGridTextColumn Header="Tax" Binding="{Binding TaxAmount, StringFormat=N2}" IsReadOnly="True" Width="68" />
                                        <DataGridTextColumn Header="Line Total" Binding="{Binding LineTotal, StringFormat=N2}" IsReadOnly="True" Width="85" />
                                        <DataGridTemplateColumn Header="Hide in PDF" Width="85">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <CheckBox IsChecked="{Binding HideOnPdf, UpdateSourceTrigger=PropertyChanged}"
