                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                        <DataGridTextColumn Header="Notes" Binding="{Binding Notes, UpdateSourceTrigger=PropertyChanged}" Width="170" />
                                        <DataGridTemplateColumn Header="Actions" Width="118">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <Button Content="Line Actions  ▾" Padding="8,4" MinWidth="102"
                                                            Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                            Click="InvoiceActionsButton_Click" ToolTip="Move, duplicate, or remove this line">
