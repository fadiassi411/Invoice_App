<Window x:Class="InvoiceSoftware.App.LicenseActivationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Invoice Maker Activation"
        Width="650" Height="455"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        Icon="Assets/InvoiceMaker.ico"
        Background="#F4F7FB">
    <Grid Margin="30">
        <Border Background="White" BorderBrush="#DCE6F2" BorderThickness="1" CornerRadius="16" Padding="30">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel>
                    <TextBlock Text="Invoice Maker" FontSize="30" FontWeight="Bold" Foreground="#0D2B68" />
                    <TextBlock Text="Professional Edition  •  Version 1.2.2" FontSize="14" Foreground="#527095" Margin="0,4,0,0" />
                </StackPanel>

                <Border Grid.Row="1" Background="#EAF7FB" BorderBrush="#76D7ED" BorderThickness="1" CornerRadius="9" Padding="14" Margin="0,22,0,0">
                    <TextBlock Text="This copy must be activated with a license created for this installation ID." TextWrapping="Wrap" Foreground="#164E63" />
                </Border>

                <StackPanel Grid.Row="2" Margin="0,20,0,0">
                    <TextBlock Text="Installation ID" FontWeight="SemiBold" Foreground="#17365D" />
                    <Grid Margin="0,7,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="InstallationIdBox" IsReadOnly="True" FontFamily="Consolas" FontSize="15" Padding="11,8" VerticalContentAlignment="Center" />
                        <Button Grid.Column="1" Content="Copy ID" Click="CopyInstallationId_Click" Margin="10,0,0,0" Padding="18,8" />
                    </Grid>
                </StackPanel>

                <Border Grid.Row="3" x:Name="StatusPanel" Background="#FFF4E5" BorderBrush="#F3C77B" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,18,0,0">
                    <TextBlock x:Name="StatusText" TextWrapping="Wrap" Foreground="#7A4A00" />
                </Border>

                <TextBlock Grid.Row="4" Margin="0,16,0,0" TextWrapping="Wrap" Foreground="#5A6B80"
                           Text="Copy the installation ID and send it to your supplier. When you receive the .invoicelicense file, choose Activate License." />

                <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,22,0,0">
                    <Button Content="Close" Click="Close_Click" Padding="20,9" Margin="0,0,10,0" />
                    <Button Content="Activate License" Click="ActivateLicense_Click" Padding="22,9" Background="#1678BF" Foreground="White" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
