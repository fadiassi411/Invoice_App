<Window x:Class="InvoiceSoftware.App.PaymentReceiptDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Create Receipt"
        Width="450" Height="470" MinHeight="450"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize"
        Background="#F4F7FB">
    <Border Margin="14" Padding="16" Background="White" BorderBrush="#DFE7F3" BorderThickness="1" CornerRadius="8">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Margin="0,0,0,14">
                <TextBlock Text="Create receipt" FontSize="20" FontWeight="SemiBold" Foreground="#0D2B68" />
                <TextBlock Text="{Binding InvoiceSummary}" Foreground="#42526B" Margin="0,4,0,0" />
                <TextBlock Text="{Binding BalanceSummary}" Foreground="#42526B" />
            </StackPanel>

            <StackPanel Grid.Row="1" Margin="0,0,0,10">
                <TextBlock Text="Payment amount" FontWeight="SemiBold" />
                <TextBox Text="{Binding PaymentAmountText, UpdateSourceTrigger=PropertyChanged}" />
            </StackPanel>

            <StackPanel Grid.Row="2" Margin="0,0,0,10">
                <TextBlock Text="Payment method" FontWeight="SemiBold" />
                <ComboBox ItemsSource="{Binding PaymentMethods}" SelectedItem="{Binding PaymentMethod}" />
            </StackPanel>

            <StackPanel Grid.Row="3" Margin="0,0,0,10">
                <TextBlock Text="Transaction reference / check number" FontWeight="SemiBold" />
                <TextBox Text="{Binding TransactionReference, UpdateSourceTrigger=PropertyChanged}" />
            </StackPanel>

            <StackPanel Grid.Row="4" Margin="0,0,0,12">
                <TextBlock Text="Receipt notes" FontWeight="SemiBold" />
                <TextBox Text="{Binding Notes, UpdateSourceTrigger=PropertyChanged}" Height="72" TextWrapping="Wrap" AcceptsReturn="True" />
            </StackPanel>

            <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Cancel" Width="86" Click="Cancel_Click" Background="#64748B" IsCancel="True" />
                <Button Content="Create Receipt" Width="120" Click="Create_Click" IsDefault="True" />
            </StackPanel>
        </Grid>
    </Border>
</Window>
