<Window x:Class="InvoiceSoftware.App.ProductSelectionDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Select Product" Width="980" Height="620" MinWidth="760" MinHeight="450"
        WindowStartupLocation="CenterOwner" Background="{StaticResource BackgroundBrush}"
        PreviewKeyDown="OnPreviewKeyDown">
    <Grid Margin="18">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <StackPanel>
            <TextBlock Text="Select a product" FontSize="24" FontWeight="SemiBold" Foreground="#0D2B68"/>
            <TextBlock Text="Search by reference, part number, barcode, name, description, category, brand, or manufacturer." Foreground="#607089" Margin="0,3,0,10"/>
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <TextBox x:Name="SearchBox" TextChanged="OnSearchChanged" KeyDown="OnSearchKeyDown" FontSize="15" ToolTip="Enter an item reference, part number, barcode, or description"/>
                <Button Grid.Column="1" Content="Search" Click="OnSearch" MinWidth="92" ToolTip="Search active stock items"/>
                <Button Grid.Column="2" Content="Clear" Click="OnClearSearch" MinWidth="82" ToolTip="Clear the search and show all active items"/>
            </Grid>
            <TextBlock x:Name="ResultMessage" Foreground="#607089" Margin="4,4,0,0"/>
        </StackPanel>
        <DataGrid x:Name="ProductsGrid" Grid.Row="1" Margin="0,12" IsReadOnly="True" SelectionMode="Single" MouseDoubleClick="OnDoubleClick" AutoGenerateColumns="False">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Reference" Binding="{Binding Code}" Width="115"/>
                <DataGridTextColumn Header="Product" Binding="{Binding Name}" Width="170"/>
                <DataGridTextColumn Header="Description" Binding="{Binding Description}" Width="*"/>
                <DataGridTextColumn Header="Available" Binding="{Binding CurrentQuantity, StringFormat={}{0:0.####}}" Width="85"/>
                <DataGridTextColumn Header="Selling Price" Binding="{Binding SellingPrice, StringFormat=N2}" Width="95"/>
                <DataGridTextColumn Header="Category" Binding="{Binding Category}" Width="105"/>
                <DataGridTextColumn Header="Location" Binding="{Binding StorageLocation}" Width="100"/>
            </DataGrid.Columns>
        </DataGrid>
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Cancel" Click="OnCancel"/>
            <Button x:Name="SelectButton" Content="Add to Invoice" Click="OnSelect" IsDefault="True"/>
        </StackPanel>
    </Grid>
</Window>
